<Application x:Class="PersonelTakip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PersonelTakip.Helpers"
             xmlns:converters="clr-namespace:PersonelTakip.Converters"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToFontWeightConverter x:Key="InverseBoolToFontWeightConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            
            <Style x:Key="ModernWindowStyle" TargetType="Window">
                <Setter Property="WindowStyle" Value="None"/>
                <Setter Property="Background" Value="#FF04132B"/>
                <Setter Property="WindowChrome.WindowChrome">
                    <Setter.Value>
                        <WindowChrome CaptionHeight="35" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" ResizeBorderThickness="5" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernDialogStyle" TargetType="Window" BasedOn="{StaticResource ModernWindowStyle}">
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
