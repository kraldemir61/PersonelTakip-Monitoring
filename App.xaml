<Application x:Class="PersonelTakip.Monitoring.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:PersonelTakip.Monitoring.Helpers"
             xmlns:converters="clr-namespace:PersonelTakip.Monitoring.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolToFontWeightConverter x:Key="InverseBoolToFontWeightConverter"/>
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>

            <!-- SİSTEM RENKLERİNİ KARANLIK TEMAYA KİLİTLE (Kesin Çözüm) -->
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"          Color="#1E293B"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}"      Color="White"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"         Color="#1E293B"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}"     Color="White"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"       Color="#3B82F6"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"   Color="White"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#334155"/>
            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
            
            <Style x:Key="ModernWindowStyle" TargetType="Window">
                <Setter Property="WindowStyle" Value="None"/>
                <Setter Property="Background" Value="#FF04132B"/>
                <Setter Property="WindowChrome.WindowChrome">
                    <Setter.Value>
                        <WindowChrome CaptionHeight="35" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" ResizeBorderThickness="5" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ModernDialogStyle" TargetType="Window" BasedOn="{StaticResource ModernWindowStyle}">
            </Style>

            <!-- Dark Scrollbar Style -->
            <Style TargetType="{x:Type ScrollBar}">
                <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false"/>
                <Setter Property="Stylus.IsFlicksEnabled" Value="false"/>
                <Setter Property="Width" Value="20"/>
                <Setter Property="MinWidth" Value="20"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="true" IsEnabled="{TemplateBinding IsEnabled}">
                                    <Track.Thumb>
                                        <Thumb x:Name="Thumb">
                                            <Thumb.Style>
                                                <Style TargetType="{x:Type Thumb}">
                                                    <Setter Property="OverridesDefaultStyle" Value="true"/>
                                                    <Setter Property="IsTabStop" Value="false"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                                <Border x:Name="rectangle" Background="#334155" CornerRadius="5" Margin="2,0"/>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="true">
                                                                        <Setter TargetName="rectangle" Property="Background" Value="#475569" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsDragging" Value="true">
                                                                        <Setter TargetName="rectangle" Property="Background" Value="#2563EB" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Thumb.Style>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="10"/>
                        <Setter Property="MinHeight" Value="10"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type ScrollBar}">
                                    <Grid x:Name="Bg" SnapsToDevicePixels="true" Background="Transparent">
                                        <Track x:Name="PART_Track" IsEnabled="{TemplateBinding IsEnabled}">
                                            <Track.Thumb>
                                                <Thumb x:Name="Thumb">
                                                    <Thumb.Style>
                                                        <Style TargetType="{x:Type Thumb}">
                                                            <Setter Property="OverridesDefaultStyle" Value="true"/>
                                                            <Setter Property="IsTabStop" Value="false"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                                                        <Border x:Name="rectangle" Background="#334155" CornerRadius="5" Margin="0,2"/>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="true">
                                                                                <Setter TargetName="rectangle" Property="Background" Value="#475569" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsDragging" Value="true">
                                                                                <Setter TargetName="rectangle" Property="Background" Value="#2563EB" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Thumb.Style>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Modern ToolTip Style -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="#1E293B"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderBrush" Value="#334155"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="HasDropShadow" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- Selectable Text Style (For copying) -->
            <Style x:Key="SelectableLabel" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="SelectionBrush" Value="#3B82F6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
