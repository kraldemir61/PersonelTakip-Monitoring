<Window x:Class="PersonelTakip.Views.CihazZimmetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="450" Width="400"
        WindowStartupLocation="CenterOwner"
        Background="#FF04132B"
        WindowStyle="None"
        AllowsTransparency="True">

    <Border BorderBrush="#2563EB" BorderThickness="1" CornerRadius="15" Background="#FF04132B">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock x:Name="TxtTitle" Text="{Binding Title}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="TxtCihaz" Text="Cihaz Bilgisi" Foreground="#94A3B8" FontSize="14" Margin="0,0,0,20"/>

            <!-- Personel Selection (Only for Assign) -->
            <StackPanel Grid.Row="2" x:Name="PnlPersonel">
                <TextBlock Text="Personel Seçin" Foreground="White" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPersonelAra" 
                         TextChanged="TxtPersonelAra_TextChanged"
                         Background="#1E293B" Foreground="White" BorderBrush="#334155" 
                         Padding="10,5" Height="35" Margin="0,0,0,10"
                         Tag="İsim ile ara..."/>
                
                <ListBox x:Name="LstPersonel" Height="150"
                         DisplayMemberPath="AdiSoyadi" SelectedValuePath="Id"
                         Background="#1E293B" Foreground="White" BorderBrush="#334155"
                         MouseDoubleClick="LstPersonel_MouseDoubleClick">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="border" Background="Transparent" CornerRadius="4">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#334155"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </StackPanel>

            <!-- Common Fields -->
            <StackPanel Grid.Row="3" Margin="0,15,0,0">
                <TextBlock Text="İşlem Tarihi" Foreground="White" Margin="0,0,0,5"/>
                <DatePicker x:Name="DtTarih" Background="#1E293B" Foreground="Black" Margin="0,0,0,15"/>

                <TextBlock Text="Açıklama" Foreground="White" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtAciklama" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                         Background="#1E293B" Foreground="White" BorderBrush="#334155" Padding="10,5"/>
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Vazgeç" Click="BtnClose_Click"
                        Width="100" Height="35" Margin="0,0,10,0"
                        Background="Transparent" Foreground="White" BorderBrush="#334155" BorderThickness="1" Cursor="Hand"/>
                <Button Content="Kaydet" Click="BtnKaydet_Click"
                        Width="100" Height="35" 
                        Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
