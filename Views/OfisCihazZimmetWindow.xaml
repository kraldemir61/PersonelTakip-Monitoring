<Window x:Class="PersonelTakip.Views.OfisCihazZimmetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ofis Cihazı Zimmet" Height="500" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtTitle" Grid.Row="0" Text="Cihaz Zimmetle" FontSize="20" FontWeight="Bold" Foreground="#1E2937" Margin="0,0,0,10"/>
        <TextBlock x:Name="TxtCihaz" Grid.Row="1" Text="Cihaz Bilgisi" Foreground="#64748B" FontSize="14" Margin="0,0,0,20"/>

        <StackPanel x:Name="PnlPersonel" Grid.Row="2">
            <TextBlock Text="Personel Seçin" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtPersonelAra" Height="35" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,5" 
                     Tag="Personel ara..." TextChanged="TxtPersonelAra_TextChanged"/>
            <ListBox x:Name="LstPersonel" Height="150" DisplayMemberPath="AdiSoyadi" SelectedValuePath="Id"
                     Margin="0,0,0,15" BorderBrush="#E2E8F0" MouseDoubleClick="LstPersonel_MouseDoubleClick"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <TextBlock Text="İşlem Tarihi" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
            <DatePicker x:Name="DtTarih" Height="35" Margin="0,0,0,15"/>

            <TextBlock Text="Açıklama" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
            <TextBox x:Name="TxtAciklama" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,5" Margin="0,0,0,15"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="İptal" Click="BtnClose_Click" Width="100" Height="40" Background="#E2E8F0" Foreground="#475569" BorderThickness="0" Margin="0,0,10,0"/>
            <Button x:Name="BtnKaydet" Content="Kaydet" Click="BtnKaydet_Click" Width="100" Height="40" Background="#3B82F6" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
