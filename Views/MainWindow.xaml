<Window x:Class="PersonelTakip.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PersonelTakip.Views"
        xmlns:vm="clr-namespace:PersonelTakip.ViewModels"
        xmlns:conv="clr-namespace:PersonelTakip.Converters"
        xmlns:controls="clr-namespace:PersonelTakip.Controls"
        mc:Ignorable="d"
        Title="{Binding PageTitle}" MinHeight="640" MinWidth="980" Height="640" Width="980"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Style="{StaticResource ModernWindowStyle}"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:RolToColorConverter x:Key="RolToColorConverter"/>
        <conv:RolToIconConverter x:Key="RolToIconConverter"/>
        <conv:AktifToTextConverter x:Key="AktifToTextConverter"/>
        <conv:AktifToColorConverter x:Key="AktifToColorConverter"/>
        <conv:EqualityConverter x:Key="EqualityConverter"/>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarFilterButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="100"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,2,10,1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#FF04132B" CornerRadius="6" BorderBrush="#2563EB" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF0C2C61"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF3C0505"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Style.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#FFA2172A"/>
                    <Setter Property="Padding" Value="10,12"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E5E7EB"/>
                            <Setter Property="Foreground" Value="#1F2937"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Blue"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:CustomTitleBar Grid.Row="0">
            <controls:CustomTitleBar.AdditionalContent>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CurrentUser.KullaniciAdi}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                        <TextBlock Text=" / " Foreground="#9CA3AF" Margin="4,0,4,0"/>
                        <TextBlock Text="{Binding CurrentUser.Rol}" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Bildirim Zili -->
                        <Grid Margin="0,0,10,0">
                            <Button Background="Transparent" BorderThickness="0" Command="{Binding ToggleBildirimPopupCommand}" Cursor="Hand" Padding="4,2" WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="Transparent" CornerRadius="4">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock Text="🔔" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                            </Button>
                            
                            <!-- Kırmızı Nokta (Unread Count) -->
                            <Border Background="#EF4444" CornerRadius="8" MinWidth="14" Height="14" 
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
                                    Visibility="{Binding HasUnreadBildirimler, Converter={StaticResource BoolToVisibilityConverter}}"
                                    IsHitTestVisible="False">
                                <TextBlock Text="{Binding UnreadBildirimCount}" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
                            </Border>
                            
                            <!-- Popup -->
                            <Popup IsOpen="{Binding IsBildirimPopupOpen}" StaysOpen="False" Placement="Bottom" HorizontalOffset="0" VerticalOffset="8" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Width="320" MaxHeight="450" Padding="15" Margin="5,5,5,15">
                                    <Border.Effect>
                                        <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="15" ShadowDepth="4" Direction="270"/>
                                    </Border.Effect>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Bildirim Merkezi" FontWeight="Bold" FontSize="15" Foreground="#111827" VerticalAlignment="Center"/>
                                            <Button Grid.Column="1" Content="Tümünü Sil" Command="{Binding TumBildirimleriSilCommand}" Background="Transparent" Foreground="#EF4444" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="0.7"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                        
                                        <Rectangle Grid.Row="1" Height="1" Fill="#F3F4F6" Margin="-15,0,-15,10"/>
                                        
                                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding BildirimlerListesi}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="#F3F4F6" BorderThickness="0,0,0,1" Padding="5,10" Background="Transparent">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding Mesaj}" TextWrapping="Wrap" FontSize="12" Foreground="#374151" FontWeight="{Binding OkunduMu, Converter={StaticResource InverseBoolToFontWeightConverter}}" LineHeight="18"/>
                                                                <Button Grid.Column="1" Content="✕" Command="{Binding DataContext.BildirimSilCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}" Foreground="#9CA3AF" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Margin="5,0,0,0">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button">
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm}" Foreground="#9CA3AF" FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>
                            </Popup>
                        </Grid>

                        <Button Content="Excel'e Aktar" Width="90" Height="24" FontSize="11" Padding="0" Command="{Binding ExportExcelCommand}" Margin="0,0,8,0" Background="#10B981" Foreground="White" Style="{StaticResource HeaderButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="Şifre Değiştir" Width="90" Height="24" FontSize="11" Padding="0" Command="{Binding ParolaDegistirCommand}" Margin="0,0,8,0" Background="#FF5D0BF5" Foreground="White" Style="{StaticResource HeaderButton}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </StackPanel>
            </controls:CustomTitleBar.AdditionalContent>
        </controls:CustomTitleBar>

        <!-- Main Content Area -->
        <TabControl Grid.Row="1" Margin="10,5,20,15" Background="#FF04132B" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="Transparent" Padding="20,12" CornerRadius="8,8,0,0" Margin="0,0,2,0">
                                    <ContentPresenter x:Name="ContentSite" ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                        <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="TabBorder" Property="Background" Value="#E5E7EB"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="#6B7280"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#111827"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#374151"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- 1. PERSONELLER -->
            <TabItem Header="Personeller">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Sidebar -->
                        <ColumnDefinition Width="*"/>    <!-- Content -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- Sidebar (Admin Filter) -->
                    <StackPanel Grid.Column="0" Margin="0,0,0,0" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding SidebarSantiyeler}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Kod}" Style="{StaticResource SidebarFilterButton}"
                                            Command="{Binding DataContext.SantiyeFiltreleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Kod}">
                                        <Button.Tag>
                                            <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                <Binding Path="Kod"/>
                                                <Binding Path="DataContext.SelectedFilterSantiye" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </Button.Tag>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Personeller Content -->
                    <Border Grid.Column="1" Background="White"  Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="320" MinWidth="250" MaxWidth="600"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="Ekle" Command="{Binding YeniPersonelCommand}" Width="100" Height="40" Background="#3B82F6" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                    <Button Content="Düzenle" Command="{Binding DuzenlePersonelCommand}" Width="100" Height="40" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                    <Button Content="Sil" Command="{Binding SilPersonelCommand}" Width="60" Height="40" Background="#EF4444" Foreground="White" Style="{StaticResource HeaderButton}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Margin="20,0,0,0" CornerRadius="20" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Height="40">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
                                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="5,0,15,0"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Text="Hızlı arama..." Foreground="#9CA3AF" VerticalAlignment="Center" IsHitTestVisible="False" Margin="10,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>

                            <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding PersonellerView}" SelectedItem="{Binding SelectedPersonel}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,5,0" BorderThickness="1" BorderBrush="#E5E7EB">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Adı Soyadı" Binding="{Binding AdiSoyadi}" Width="*"/>
                                    <DataGridTextColumn Header="Şantiye" Binding="{Binding SantiyeKod}" Width="100"/>
                                    <DataGridTextColumn Header="Bölümü" Binding="{Binding BolumuDisplay}" Width="120" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Görevi" Binding="{Binding GoreviDisplay}" Width="120" Visibility="Collapsed"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True" Cursor="SizeWE" Margin="0,0,5,0"/>

                            <Border Grid.Row="1" Grid.Column="2" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15" Margin="5,0,0,0">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05" Direction="270" Color="#000000"/>
                                </Border.Effect>
                                <Grid>
                                    <StackPanel Visibility="{Binding SelectedPersonel, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                        <Border Width="60" Height="60" Background="#DBEAFE" CornerRadius="40" Margin="0,0,0,5">
                                            <TextBlock Text="👤" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3B82F6"/>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedPersonel.AdiSoyadi}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                                            <TextBlock Text="{Binding SelectedPersonel.GoreviDisplay}" Foreground="#6B7280"/>
                                            <TextBlock Text=" • " Foreground="#9CA3AF" Margin="5,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedPersonel.UyruguDisplay}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding SelectedPersonel.UyruguDisplay}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding SelectedPersonel.UyruguDisplay}" Foreground="#6B7280"/>
                                        </StackPanel>
                                        <Separator Margin="0,0,0,20"/>
                                        <StackPanel>
                                            <TextBlock Text="ŞANTİYE" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding SelectedPersonel.SantiyeKod}" FontSize="14" Margin="0,0,0,12"/>
                                            <TextBlock Text="BÖLÜM" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding SelectedPersonel.BolumuDisplay}" FontSize="14" Margin="0,0,0,12"/>
                                            <TextBlock Text="TELEFON" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding SelectedPersonel.TelefonNumarasi}" FontSize="14" Margin="0,0,0,12"/>
                                            <TextBlock Text="MAAŞ" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2" Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{Binding SelectedPersonel.Maas, StringFormat=N2}" FontSize="16" FontWeight="Bold" Foreground="#10B981"/>
                                                <TextBlock Text="{Binding SelectedPersonel.ParaBirimiDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="#065F46" Margin="5,0,0,0" VerticalAlignment="Bottom"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid Visibility="{Binding SelectedPersonel, Converter={StaticResource NullToVisibilityConverter}}">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Genel Durum Özeti" FontSize="18" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,15"/>
                                        
                                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                            <StackPanel>
                                                <!-- Toplam Personel -->
                                                <Border CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#EEF2FF" Offset="0.0"/>
                                                            <GradientStop Color="#E0E7FF" Offset="1.0"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.05" Color="#4F46E5"/>
                                                    </Border.Effect>
                                                    <StackPanel>
                                                        <TextBlock Text="Toplam Aktif Personel" FontSize="13" FontWeight="SemiBold" Foreground="#4338CA"/>
                                                        <TextBlock Text="{Binding ToplamPersonel}" FontSize="28" FontWeight="Bold" Foreground="#312E81" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Şantiye / Bölüm / Uyruk Dağılımı -->
                                                <TextBlock Text="Şantiye / Bölüm / Uyruk Dağılımı" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,10"/>
                                                <ItemsControl ItemsSource="{Binding SantiyeStats}" Margin="0,0,0,15">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,0,10">
                                                                <StackPanel>
                                                                    <!-- Şantiye Başlığı -->
                                                                    <Border Background="#F3F4F6" CornerRadius="6,6,0,0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Name}" Foreground="#1F2937" FontWeight="Bold" Padding="10,8"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="Bold" Foreground="#111827" Padding="10,8"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    
                                                                    <!-- Bölüm Listesi -->
                                                                    <ItemsControl ItemsSource="{Binding SubItems}" Margin="10,8,10,8">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Margin="0,0,0,8">
                                                                                    <Grid Margin="0,0,0,4">
                                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                                        <TextBlock Text="{Binding Name}" Foreground="#4B5563" FontWeight="SemiBold"/>
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="SemiBold" Foreground="#4B5563"/>
                                                                                    </Grid>
                                                                                    
