                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CihazAdi}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <Border Background="{Binding ZimmetliMi, Converter={StaticResource StatusToColorConverter}}" CornerRadius="4" Padding="8,2" HorizontalAlignment="Left" Margin="0,5,0,0">
                                <TextBlock Text="{Binding ZimmetliMi, Converter={StaticResource StatusToTextConverter}}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Ana Bilgiler Kartı -->
