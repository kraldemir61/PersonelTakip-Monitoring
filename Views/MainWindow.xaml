                                            <Button Content="Düzenle" Command="{Binding DuzenleSantiyeCommand}" Width="100" Height="40" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                            <Button Content="Sil" Command="{Binding SilSantiyeCommand}" Width="60" Height="40" Background="#EF4444" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                            <Button Content="Silinenleri Yönet" Command="{Binding OpenPasifSantiyelerCommand}" Width="130" Height="40" Background="#6B7280" Foreground="White" Style="{StaticResource HeaderButton}"
