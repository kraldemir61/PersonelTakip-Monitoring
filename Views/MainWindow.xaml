                                  IsChecked="{Binding OlcumCihaziFilterAssigned}"
                                  Style="{StaticResource SidebarFilterToggleButton}"/>

                    <Button Content="Transfer / Hareket" Command="{Binding OlcumCihaziHareketCommand}" Width="150" Height="38" Background="#3B82F6" Foreground="White" Style="{StaticResource HeaderButton}" Margin="5,0,5,0" Visibility="{Binding IsNotMonitoringMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button Content="Geçmiş" Command="{Binding OlcumCihaziGecmisCommand}" Width="80" Height="38" Background="#6B7280" Foreground="White" Style="{StaticResource HeaderButton}" Margin="5,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsNotMonitoringMode, Converter={StaticResource BoolToVisibilityConverter}}">
