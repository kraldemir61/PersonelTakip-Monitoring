<Window x:Class="PersonelTakip.Monitoring.Views.MainWindow"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:PersonelTakip.Monitoring.Views"
xmlns:vm="clr-namespace:PersonelTakip.Monitoring.ViewModels"
xmlns:conv="clr-namespace:PersonelTakip.Monitoring.Converters"
xmlns:controls="clr-namespace:PersonelTakip.Monitoring.Controls"
xmlns:helpers="clr-namespace:PersonelTakip.Monitoring.Helpers"
mc:Ignorable="d"
Title="{Binding PageTitle}" MinHeight="640" MinWidth="980" Height="640" Width="980"
Icon="/Resources/PersonelZimmet.ikon.ico"
WindowStartupLocation="CenterScreen"
WindowState="Maximized"
Style="{StaticResource ModernWindowStyle}"
d:DataContext="{d:DesignInstance vm:MainViewModel}">
<Window.InputBindings>
<KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding OpenDatabaseSettingsCommand}"/>
</Window.InputBindings>
<Window.Resources>
<BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
<helpers:BooleanInverter x:Key="InverseBoolConverter"/>
<conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
<conv:RolToColorConverter x:Key="RolToColorConverter"/>
<conv:RolToIconConverter x:Key="RolToIconConverter"/>
<conv:AktifToTextConverter x:Key="AktifToTextConverter"/>
<conv:AktifToColorConverter x:Key="AktifToColorConverter"/>
<conv:EqualityConverter x:Key="EqualityConverter"/>
<conv:FotoPathToImageConverter x:Key="FotoPathToImageConverter"/>
<conv:StatusToColorConverter x:Key="StatusToColorConverter"/>
<conv:StatusToTextConverter x:Key="StatusToTextConverter"/>
<SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
<SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="White"/>
<!-- Sidebar Button Style -->
<Style x:Key="SidebarFilterButton" TargetType="Button">
<Setter Property="HorizontalAlignment" Value="Stretch"/>
<Setter Property="MinWidth" Value="100"/>
<Setter Property="Height" Value="35"/>
<Setter Property="Margin" Value="0,2,10,1"/>
<Setter Property="FontSize" Value="13"/>
<Setter Property="FontWeight" Value="Bold"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="Button">
<Border x:Name="border" Background="#FF04132B" CornerRadius="6" BorderBrush="#2563EB" BorderThickness="1">
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter TargetName="border" Property="Background" Value="#FF0C2C61"/>
</Trigger>
<DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
<Setter TargetName="border" Property="Background" Value="#FF3C0505"/>
<Setter TargetName="border" Property="BorderThickness" Value="2"/>
<Setter TargetName="border" Property="BorderBrush" Value="White"/>
</DataTrigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
<!-- Sidebar ToggleButton Style -->
<Style x:Key="SidebarFilterToggleButton" TargetType="ToggleButton">
<Setter Property="Height" Value="32"/>
<Setter Property="Padding" Value="10,0"/>
<Setter Property="FontSize" Value="13"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="Background" Value="#1E293B"/>
<Setter Property="Foreground" Value="#94A3B8"/>
<Setter Property="BorderThickness" Value="1"/>
<Setter Property="BorderBrush" Value="#334155"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="ToggleButton">
<Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter TargetName="border" Property="Background" Value="#334155"/>
<Setter Property="Foreground" Value="White"/>
</Trigger>
<Trigger Property="IsChecked" Value="True">
<Setter TargetName="border" Property="Background" Value="#2563EB"/>
<Setter Property="Foreground" Value="White"/>
<Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
<Style x:Key="HeaderButton" TargetType="Button">
<Setter Property="Padding" Value="0"/>
<Setter Property="FontSize" Value="13"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="Button">
<Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
<!-- Modern Aksiyon Butonu Stili -->
<Style x:Key="ActionButton" TargetType="Button">
<Setter Property="Padding" Value="15,8"/>
<Setter Property="FontSize" Value="13"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="Foreground" Value="White"/>
<Setter Property="Cursor" Value="Hand"/>
<Setter Property="BorderThickness" Value="0"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="Button">
<Border x:Name="border" Height="35" Background="{TemplateBinding Background}" CornerRadius="8">
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter Property="Opacity" Value="0.8"/>
</Trigger>
<Trigger Property="IsPressed" Value="True">
<Setter Property="Opacity" Value="0.6"/>
</Trigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
</Style>
<!-- Modern DataGrid Style -->
<Style TargetType="DataGrid">
<Setter Property="Background" Value="Transparent"/>
<Setter Property="BorderThickness" Value="0"/>
<Setter Property="GridLinesVisibility" Value="None"/>
<Setter Property="RowHeight" Value="45"/>
<Setter Property="AlternatingRowBackground" Value="#1E293B"/>
<Setter Property="AlternationCount" Value="2"/>
<Setter Property="SelectionMode" Value="Single"/>
<Setter Property="SelectionUnit" Value="FullRow"/>
<Style.Resources>
<Style TargetType="DataGridColumnHeader">
<Setter Property="Background" Value="#334155"/>
<Setter Property="Foreground" Value="White"/>
<Setter Property="Padding" Value="15,10"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="BorderThickness" Value="0,0,0,1"/>
<Setter Property="BorderBrush" Value="#475569"/>
</Style>
<Style TargetType="DataGridRow">
<Setter Property="Background" Value="Transparent"/>
<Setter Property="Foreground" Value="#E2E8F0"/>
<Setter Property="BorderThickness" Value="0,0,0,1"/>
<Setter Property="BorderBrush" Value="#334155"/>
<Style.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter Property="Background" Value="#2D3748"/>
</Trigger>
<Trigger Property="IsSelected" Value="True">
<Setter Property="Background" Value="#FF151515"/>
<Setter Property="Foreground" Value="White"/>
</Trigger>
</Style.Triggers>
</Style>
<Style TargetType="DataGridCell">
<Setter Property="BorderThickness" Value="0"/>
<Setter Property="FocusVisualStyle" Value="{x:Null}"/>
<Setter Property="Padding" Value="15,0"/>
<Setter Property="Background" Value="Transparent"/>
<Setter Property="HorizontalContentAlignment" Value="Left"/>
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="DataGridCell">
<Border Background="{TemplateBinding Background}"
BorderBrush="{TemplateBinding BorderBrush}"
BorderThickness="{TemplateBinding BorderThickness}"
SnapsToDevicePixels="True">
<ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
VerticalAlignment="Center"
HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
Margin="{TemplateBinding Padding}"/>
</Border>
</ControlTemplate>
</Setter.Value>
</Setter>
<Style.Triggers>
<Trigger Property="IsSelected" Value="True">
<Setter Property="Background" Value="Transparent"/>
<Setter Property="BorderBrush" Value="Transparent"/>
<Setter Property="Foreground" Value="White"/>
</Trigger>
</Style.Triggers>
</Style>
</Style.Resources>
</Style>
</Window.Resources>
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
</Grid.RowDefinitions>
<controls:CustomTitleBar Grid.Row="0">
<controls:CustomTitleBar.AdditionalContent>
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
</Grid.ColumnDefinitions>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
<!-- User Info -->
<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
<Ellipse Width="10" Height="10" Margin="0,0,8,0">
<Ellipse.Style>
<Style TargetType="Ellipse">
<Setter Property="Fill" Value="#EF4444"/> <!-- Red default -->
<Style.Triggers>
<DataTrigger Binding="{Binding IsConnected}" Value="True">
<Setter Property="Fill" Value="#10B981"/> <!-- Green -->
</DataTrigger>
<MultiDataTrigger>
<MultiDataTrigger.Conditions>
<Condition Binding="{Binding IsConnected}" Value="True"/>
<Condition Binding="{Binding IsSlowConnection}" Value="True"/>
</MultiDataTrigger.Conditions>
<Setter Property="Fill" Value="#F59E0B"/> <!-- Orange -->
</MultiDataTrigger>
</Style.Triggers>
</Style>
</Ellipse.Style>
<Ellipse.ToolTip>
<ToolTip Content="{Binding ConnectionStatus}"/>
</Ellipse.ToolTip>
</Ellipse>
<TextBlock Text="{Binding CurrentUser.KullaniciAdi}" FontWeight="Bold" Foreground="White" FontSize="13"/>
<TextBlock Text=" / " Foreground="#9CA3AF" Margin="4,0,4,0"/>
<TextBlock Text="{Binding CurrentUser.Rol}" Foreground="#9CA3AF" FontSize="11" VerticalAlignment="Center"/>
</StackPanel>
<!-- Actions -->
<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
<!-- Bildirim Zili -->
<Grid Margin="0,0,10,0">
<Button Background="Transparent" BorderThickness="0" Command="{Binding ToggleBildirimPopupCommand}" Cursor="Hand" Padding="4,2" WindowChrome.IsHitTestVisibleInChrome="True">
<Button.Template>
<ControlTemplate TargetType="Button">
<Border Background="Transparent" CornerRadius="4">
<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Border>
</ControlTemplate>
</Button.Template>
<TextBlock Text="🔔" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
</Button>
<Border Background="#EF4444" CornerRadius="8" MinWidth="14" Height="14"
HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0"
Visibility="{Binding HasUnreadBildirimler, Converter={StaticResource BoolToVisibilityConverter}}"
IsHitTestVisible="False">
<TextBlock Text="{Binding UnreadBildirimCount}" Foreground="White" FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0"/>
</Border>
            <Popup IsOpen="{Binding IsBildirimPopupOpen}" StaysOpen="False" Placement="Bottom" HorizontalOffset="0" VerticalOffset="8" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Width="330" MaxHeight="350" Padding="15" Margin="5,5,5,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bildirim Merkezi" FontWeight="Bold" FontSize="15" Foreground="White" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Tümünü Sil" Command="{Binding TumBildirimleriSilCommand}" Background="Transparent" Foreground="#EF4444" FontSize="11" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <TextBlock Text="{TemplateBinding Content}" TextDecorations="Underline"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                        <Rectangle Grid.Row="1" Height="1" Fill="#334155" Margin="-15,0,-15,10"/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding BildirimlerListesi}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="5,10" Background="Transparent" Cursor="Hand">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.OpenBildirimMerkeziCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Mesaj}" TextWrapping="Wrap" FontSize="12" Foreground="#E2E8F0" LineHeight="18"/>
                                                <Button Grid.Column="1" Content="✕" Command="{Binding DataContext.BildirimSilCommand, RelativeSource={RelativeSource AncestorType=Popup}}" CommandParameter="{Binding}" Foreground="#64748B" Background="Transparent" BorderThickness="0" Cursor="Hand" VerticalAlignment="Top" Margin="5,0,0,0"/>
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm}" Foreground="#64748B" FontSize="10" Margin="0,6,0,0" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Popup>
</Grid>
<Button Content="Raporlar" Width="80" Height="24" FontSize="11" Padding="0" Command="{Binding OpenReportsCommand}" Margin="0,0,8,0" Background="#3B82F6" Foreground="White" Style="{StaticResource HeaderButton}" WindowChrome.IsHitTestVisibleInChrome="True" Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
<Button Content="Şifre Değiştir" Width="90" Height="24" FontSize="11" Padding="0" Command="{Binding ParolaDegistirCommand}" Margin="0,0,8,0" Background="#FF5D0BF5" Foreground="White" Style="{StaticResource HeaderButton}" WindowChrome.IsHitTestVisibleInChrome="True" Visibility="{Binding IsNotMonitoringMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
</StackPanel>
</StackPanel>
</Grid>
</controls:CustomTitleBar.AdditionalContent>
</controls:CustomTitleBar>
<!-- Main Content Area -->
<TabControl Grid.Row="1" Margin="10,5,10,15" Background="#FF04132B" BorderThickness="0"
SelectedIndex="{Binding SelectedTabIndex}">
<TabControl.Resources>
<Style TargetType="TabItem">
<Setter Property="Template">
<Setter.Value>
<ControlTemplate TargetType="TabItem">
<Border x:Name="TabBorder" Cursor="Hand" Background="#FF04132B" Padding="15,12" CornerRadius="8,8,8,8" Margin="0,0,2,0">
<ContentPresenter x:Name="ContentSite" ContentSource="Header"/>
</Border>
<ControlTemplate.Triggers>
<Trigger Property="IsSelected" Value="True">
<Setter TargetName="TabBorder" Property="Background" Value="#FF3C0505"/>
<Setter TargetName="TabBorder" Property="BorderBrush" Value="White"/>
<Setter TargetName="TabBorder" Property="BorderThickness" Value="2,2,2,2"/>
</Trigger>
<MultiTrigger>
<MultiTrigger.Conditions>
<Condition Property="IsMouseOver" Value="True"/>
<Condition Property="IsSelected" Value="False"/>
</MultiTrigger.Conditions>
<Setter TargetName="TabBorder" Property="Background" Value="#FF0C2C61"/>
</MultiTrigger>
</ControlTemplate.Triggers>
</ControlTemplate>
</Setter.Value>
</Setter>
<Setter Property="Foreground" Value="Gray"/>
<Setter Property="FontSize" Value="14"/>
<Style.Triggers>
<Trigger Property="IsSelected" Value="True">
<Setter Property="Foreground" Value="White"/>
<Setter Property="FontWeight" Value="SemiBold"/>
</Trigger>
<Trigger Property="IsMouseOver" Value="True">
<Setter Property="Foreground" Value="White"/>
</Trigger>
</Style.Triggers>
</Style>
</TabControl.Resources>
<!-- 1. PERSONELLER -->
<TabItem Header="Personeller">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/> <!-- Sidebar -->
<ColumnDefinition Width="*"/>    <!-- Content -->
</Grid.ColumnDefinitions>
<!-- Sidebar (Admin Filter) -->
<StackPanel Grid.Column="0" Margin="0,0,0,0" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
<ItemsControl ItemsSource="{Binding SidebarSantiyeler}">
<ItemsControl.ItemTemplate>
<DataTemplate>
<Button Content="{Binding Kod}" Style="{StaticResource SidebarFilterButton}"
Command="{Binding DataContext.SantiyeFiltreleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
CommandParameter="{Binding Kod}">
<Button.Tag>
<MultiBinding Converter="{StaticResource EqualityConverter}">
<Binding Path="Kod"/>
<Binding Path="DataContext.SelectedFilterSantiye" RelativeSource="{RelativeSource AncestorType=Window}"/>
</MultiBinding>
</Button.Tag>
</Button>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
</StackPanel>
<!-- Personeller Content -->
<Border Grid.Column="1" Background="#0F172A" CornerRadius="0,0,12,12" Padding="0">
<Grid>
<Grid.RowDefinitions>
<RowDefinition Height="Auto"/>
<RowDefinition Height="*"/>
</Grid.RowDefinitions>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="*"/>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="320" MinWidth="250" MaxWidth="600"/>
</Grid.ColumnDefinitions>
<Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,5">
<Grid.ColumnDefinitions>
<ColumnDefinition Width="Auto"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Visibility="{Binding IsNotMonitoringMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Button Content="Ekle" Command="{Binding YeniPersonelCommand}" Width="100" Height="40" Background="#3B82F6" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                            <Button Content="Düzenle" Command="{Binding DuzenlePersonelCommand}" Width="100" Height="40" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                            <Button Content="Sil" Command="{Binding SilPersonelCommand}" Width="60" Height="40" Background="#EF4444" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                            <Button Content="Excel'e Aktar" Command="{Binding ExportExcelCommand}" Width="110" Height="40" Background="#10B981" Foreground="White" Style="{StaticResource HeaderButton}"/>
                        </StackPanel>
<Border Grid.Column="1" Margin="0,0,0,0" CornerRadius="10" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Height="40">
<Grid>
<Grid.ColumnDefinitions>
<ColumnDefinition Width="40"/>
<ColumnDefinition Width="*"/>
</Grid.ColumnDefinitions>
<TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5" Foreground="White"/>
<TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Foreground="White" VerticalContentAlignment="Center" Padding="5,0,15,0"
Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" CaretBrush="White"/>
<TextBlock Grid.Column="1" Text="Hızlı arama..." Foreground="#64748B" VerticalAlignment="Center" IsHitTestVisible="False" Margin="10,0,0,0">
<TextBlock.Style>
<Style TargetType="TextBlock">
<Setter Property="Visibility" Value="Collapsed"/>
<Style.Triggers>
<DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
<Setter Property="Visibility" Value="Visible"/>
</DataTrigger>
</Style.Triggers>
</Style>
</TextBlock.Style>
</TextBlock>
</Grid>
</Border>
</Grid>
<Border Grid.Row="1" Grid.Column="0" CornerRadius="12" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" Padding="1" Margin="0,0,0,0">
                    <DataGrid ItemsSource="{Binding PersonellerView}" SelectedItem="{Binding SelectedPersonel}"
                              SelectedIndex="-1"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                              Background="Transparent" BorderThickness="0" RowHeight="45">
<DataGrid.Resources>
<Style TargetType="DataGridColumnHeader">
<Setter Property="Background" Value="#334155"/>
<Setter Property="Foreground" Value="White"/>
<Setter Property="Padding" Value="15,10"/>
<Setter Property="FontWeight" Value="SemiBold"/>
<Setter Property="BorderThickness" Value="0,0,0,1"/>
<Setter Property="BorderBrush" Value="#475569"/>
</Style>
<Style TargetType="DataGridRow">
<Setter Property="Background" Value="Transparent"/>
<Setter Property="Foreground" Value="#E2E8F0"/>
<Setter Property="BorderThickness" Value="0,0,0,1"/>
<Setter Property="BorderBrush" Value="#334155"/>
<Style.Triggers>
<Trigger Property="IsMouseOver" Value="True">
<Setter Property="Background" Value="#2D3748"/>
</Trigger>
<Trigger Property="IsSelected" Value="True">
<Setter Property="Background" Value="#FF151515"/>
<Setter Property="Foreground" Value="White"/>
</Trigger>
</Style.Triggers>
</Style>
<SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#334155"/>
<SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#334155"/>
</DataGrid.Resources>
<DataGrid.Columns>
<DataGridTextColumn Header="Adı Soyadı" Binding="{Binding AdiSoyadi}" Width="*"/>
<DataGridTextColumn Header="Şantiye" Binding="{Binding SantiyeKod}" Width="100"/>
<DataGridTextColumn Header="Bölümü" Binding="{Binding BolumuDisplay}" Width="120"/>
<DataGridTextColumn Header="Görevi" Binding="{Binding GoreviDisplay}" Width="120"/>
</DataGrid.Columns>
</DataGrid>
</Border>
<GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True" Cursor="SizeWE" Margin="0,0,5,0"/>
<Border Grid.Row="1" Grid.Column="2" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="15" Margin="5,0,0,0">
<Grid>
<StackPanel Visibility="{Binding SelectedPersonel, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
<Border Width="60" Height="60" Background="#3B82F6" CornerRadius="40" Margin="0,0,0,10">
<TextBlock Text="&#x1F464;" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
</Border>
<TextBlock Text="{Binding SelectedPersonel.AdiSoyadi}" FontSize="14" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"/>
<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
<TextBlock Text="{Binding SelectedPersonel.GoreviDisplay}" Foreground="#94A3B8"/>
<TextBlock Text=" &#x2022; " Foreground="#64748B" Margin="5,0">
<TextBlock.Style>
<Style TargetType="TextBlock">
<Setter Property="Visibility" Value="Visible"/>
<Style.Triggers>
<DataTrigger Binding="{Binding SelectedPersonel.UyruguDisplay}" Value="{x:Null}">
<Setter Property="Visibility" Value="Collapsed"/>
</DataTrigger>
<DataTrigger Binding="{Binding SelectedPersonel.UyruguDisplay}" Value="">
<Setter Property="Visibility" Value="Collapsed"/>
</DataTrigger>
</Style.Triggers>
</Style>
</TextBlock.Style>
</TextBlock>
<TextBlock Text="{Binding SelectedPersonel.UyruguDisplay}" Foreground="#94A3B8"/>
</StackPanel>
<Separator Background="#334155" Margin="0,0,0,20"/>
<StackPanel>
<TextBlock Text="ŞANTİYE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
<TextBlock Text="{Binding SelectedPersonel.SantiyeKod}" FontSize="15" Foreground="White" Margin="0,0,0,15"/>
<TextBlock Text="BÖLÜM" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
<TextBlock Text="{Binding SelectedPersonel.BolumuDisplay}" FontSize="15" Foreground="White" Margin="0,0,0,15"/>
<TextBlock Text="TELEFON" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4"/>
<TextBlock Text="{Binding SelectedPersonel.TelefonNumarasi}" FontSize="15" Foreground="White" Margin="0,0,0,15"/>
<TextBlock Text="MAAŞ" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,4" Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
<StackPanel Orientation="Horizontal" Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
<TextBlock Text="{Binding SelectedPersonel.Maas, StringFormat=N2}" FontSize="18" FontWeight="Bold" Foreground="#10B981"/>
<TextBlock Text="{Binding SelectedPersonel.ParaBirimiDisplay}" FontSize="14" FontWeight="SemiBold" Foreground="#10B981" Opacity="0.8" Margin="5,0,0,0" VerticalAlignment="Bottom"/>
                    </StackPanel>
                    
                    <Border Background="#0F172A" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="ZİMMETLİ CİHAZLAR" FontSize="10" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding SelectedPersonelDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
