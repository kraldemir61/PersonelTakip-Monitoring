<Window x:Class="PersonelTakip.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PersonelTakip.Views"
        xmlns:vm="clr-namespace:PersonelTakip.ViewModels"
        xmlns:conv="clr-namespace:PersonelTakip.Converters"
        mc:Ignorable="d"
        Title="{Binding PageTitle}" MinHeight="640" MinWidth="980" Height="640" Width="980"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F3F4F6"
        d:DataContext="{d:DesignInstance vm:MainViewModel}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:RolToColorConverter x:Key="RolToColorConverter"/>
        <conv:RolToIconConverter x:Key="RolToIconConverter"/>
        <conv:AktifToTextConverter x:Key="AktifToTextConverter"/>
        <conv:AktifToColorConverter x:Key="AktifToColorConverter"/>
        <conv:EqualityConverter x:Key="EqualityConverter"/>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarFilterButton" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5,2,5,1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#FF04132B" CornerRadius="6" BorderBrush="#2563EB" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF0C2C61"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Tag}" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF3C0505"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Style.Resources>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#F1F5F9"/>
                    <Setter Property="Foreground" Value="#FFA2172A"/>
                    <Setter Property="Padding" Value="10,12"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                </Style>
                <Style TargetType="DataGridRow">
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E5E7EB"/>
                            <Setter Property="Foreground" Value="#1F2937"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="DataGridCell">
                                <Border Background="{TemplateBinding Background}" 
                                        BorderBrush="{TemplateBinding BorderBrush}" 
                                        BorderThickness="{TemplateBinding BorderThickness}" 
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                                      VerticalAlignment="Center"
                                                      Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="Foreground" Value="Blue"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <Border Grid.Row="0" Height="45" Background="#FF26306B" Padding="20,0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="#10B981" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding CurrentUser.KullaniciAdi}" FontWeight="Bold" Foreground="White" FontSize="15"/>
                    <TextBlock Text=" / " Foreground="Red" Margin="6,2,0,2"/>
                    <TextBlock Text="{Binding CurrentUser.Rol}" Foreground="Red" Margin="0,2,2,2"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Şifre Değiştir" Width="100" Height="30" Command="{Binding ParolaDegistirCommand}" Margin="0,0,10,0" Background="#FF5D0BF5" Foreground="White" Style="{StaticResource HeaderButton}"/>
                    <Button Content="Çıkış" Height="30" Width="60" Command="{Binding LogoutCommand}" Background="#EF4444" Foreground="White" Style="{StaticResource HeaderButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <TabControl Grid.Row="1" Margin="15,5,20,15" Background="#FF04132B" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBorder" Background="Transparent" Padding="20,12" CornerRadius="8,8,0,0" Margin="0,0,2,0">
                                    <ContentPresenter x:Name="ContentSite" ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="White"/>
                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B82F6"/>
                                        <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,0,0,2"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                            <Condition Property="IsSelected" Value="False"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="TabBorder" Property="Background" Value="#E5E7EB"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="#6B7280"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#111827"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#374151"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TabControl.Resources>

            <!-- 1. PERSONELLER -->
            <TabItem Header="Personeller">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Sidebar -->
                        <ColumnDefinition Width="*"/>    <!-- Content -->
                    </Grid.ColumnDefinitions>
                    
                    <!-- Sidebar (Admin Filter) -->
                    <StackPanel Grid.Column="0" Margin="0,0,0,0" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding SidebarSantiyeler}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Kod}" Style="{StaticResource SidebarFilterButton}"
                                            Command="{Binding DataContext.SantiyeFiltreleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Kod}">
                                        <Button.Tag>
                                            <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                <Binding Path="Kod"/>
                                                <Binding Path="DataContext.SelectedFilterSantiye" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </Button.Tag>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Personeller Content -->
                    <Border Grid.Column="1" Background="White"  Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="Ekle" Command="{Binding YeniPersonelCommand}" Width="100" Height="40" Background="#3B82F6" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                    <Button Content="Düzenle" Command="{Binding DuzenlePersonelCommand}" Width="100" Height="40" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                    <Button Content="Sil" Command="{Binding SilPersonelCommand}" Width="60" Height="40" Background="#EF4444" Foreground="White" Style="{StaticResource HeaderButton}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Margin="20,0,0,0" CornerRadius="20" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Height="40">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
                                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="5,0,15,0"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Text="Hızlı arama..." Foreground="#9CA3AF" VerticalAlignment="Center" IsHitTestVisible="False" Margin="10,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>

                            <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding PersonellerView}" SelectedItem="{Binding SelectedPersonel}"
                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,0,20,0" BorderThickness="1" BorderBrush="#E5E7EB">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Adı Soyadı" Binding="{Binding AdiSoyadi}" Width="*"/>
                                    <DataGridTextColumn Header="Şantiye" Binding="{Binding SantiyeKod}" Width="100"/>
                                    <DataGridTextColumn Header="Bölümü" Binding="{Binding BolumuDisplay}" Width="120" Visibility="Collapsed"/>
                                    <DataGridTextColumn Header="Görevi" Binding="{Binding GoreviDisplay}" Width="120" Visibility="Collapsed"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="1" Grid.Column="1" Background="#F9FAFB" CornerRadius="8" BorderBrush="#E5E7EB" BorderThickness="1" Padding="10">
                                <Grid>
                                    <StackPanel Visibility="{Binding SelectedPersonel, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                        <Border Width="60" Height="60" Background="#DBEAFE" CornerRadius="40" Margin="0,0,0,5">
                                            <TextBlock Text="👤" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3B82F6"/>
                                        </Border>
                                        <TextBlock Text="{Binding SelectedPersonel.AdiSoyadi}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="{Binding SelectedPersonel.GoreviDisplay}" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                        <Separator Margin="0,0,0,20"/>
                                        <StackPanel>
                                            <TextBlock Text="ŞANTİYE" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding SelectedPersonel.SantiyeKod}" FontSize="14" Margin="0,0,0,12"/>
                                            <TextBlock Text="BÖLÜM" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding SelectedPersonel.BolumuDisplay}" FontSize="14" Margin="0,0,0,12"/>
                                            <TextBlock Text="TELEFON" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding SelectedPersonel.TelefonNumarasi}" FontSize="14" Margin="0,0,0,12"/>
                                            <TextBlock Text="MAAŞ" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding SelectedPersonel.Maas, StringFormat=N2}" FontSize="16" FontWeight="Bold" Foreground="#10B981"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="Detay için personel seçin" Visibility="{Binding SelectedPersonel, Converter={StaticResource NullToVisibilityConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#9CA3AF"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

                <!-- 2. KULLANICILAR -->
                <TabItem Header="Kullanıcılar" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/> <!-- Sidebar -->
                            <ColumnDefinition Width="*"/>    <!-- Content -->
                        </Grid.ColumnDefinitions>
                        
                        <!-- Sidebar (Kullanıcılar) -->
                        <StackPanel Grid.Column="0" Margin="0,0,0,0" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ItemsControl ItemsSource="{Binding SidebarKullaniciSantiyeler}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Kod}" Style="{StaticResource SidebarFilterButton}"
                                                Command="{Binding DataContext.KullaniciSantiyeFiltreleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Kod}">
                                            <Button.Tag>
                                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                                    <Binding Path="Kod"/>
                                                    <Binding Path="DataContext.SelectedKullaniciFilterSantiye" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                </MultiBinding>
                                            </Button.Tag>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Content -->
                        <Border Grid.Column="1" Background="White" CornerRadius="0,12,12,12" Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="Ekle" Command="{Binding YeniKullaniciCommand}" Width="100" Height="40" Background="#3B82F6" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                    <Button Content="Düzenle" Command="{Binding DuzenleKullaniciCommand}" Width="100" Height="40" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                    <Button Content="Rol Değiştir" Command="{Binding RolDegistirCommand}" Width="100" Height="40" Background="#8B5CF6" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                    <Button Content="Sil" Command="{Binding SilKullaniciCommand}" Width="60" Height="40" Background="#EF4444" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                    <Button Content="Şifre Sıfırla" Command="{Binding SifreSifirlaCommand}" Width="110" Height="40" Background="#10B981" Foreground="White" Style="{StaticResource HeaderButton}" Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Margin="20,0,0,0" CornerRadius="20" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Height="40">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
                                        <TextBox x:Name="SearchBoxKullanicilar" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="5,0,15,0"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Text="Hızlı arama..." Foreground="#9CA3AF" VerticalAlignment="Center" IsHitTestVisible="False" Margin="10,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBoxKullanicilar}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding KullanicilarView}" SelectedItem="{Binding SelectedKullanici}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#E5E7EB">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kullanıcı Adı" Binding="{Binding KullaniciAdi}" Width="200"/>
                                    <DataGridTextColumn Header="Rol" Binding="{Binding Rol}" Width="100"/>
                                    <DataGridTextColumn Header="Şantiye" Binding="{Binding SantiyeAdi}" Width="200"/>
                                    <DataGridCheckBoxColumn Header="Aktif" Binding="{Binding Aktif}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

                <!-- 3. ŞANTİYELER -->
                <TabItem Header="Şantiyeler" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="White" CornerRadius="0,12,12,12" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="Ekle" Command="{Binding YeniSantiyeCommand}" Width="100" Height="40" Background="#3B82F6" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                    <Button Content="Düzenle" Command="{Binding DuzenleSantiyeCommand}" Width="100" Height="40" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                    <Button Content="Sil" Command="{Binding SilSantiyeCommand}" Width="60" Height="40" Background="#EF4444" Foreground="White" Style="{StaticResource HeaderButton}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Margin="20,0,0,0" CornerRadius="20" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Height="40">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
                                        <TextBox x:Name="SearchBoxSantiyeler" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="5,0,15,0"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Text="Hızlı arama..." Foreground="#9CA3AF" VerticalAlignment="Center" IsHitTestVisible="False" Margin="10,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBoxSantiyeler}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding SantiyeListView}" SelectedItem="{Binding SelectedSantiye}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#E5E7EB">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Kod" Binding="{Binding Kod}" Width="100"/>
                                    <DataGridTextColumn Header="Şantiye Adı" Binding="{Binding Adi}" Width="*"/>
                                    <DataGridTextColumn Header="Adres" Binding="{Binding Adres}" Width="300"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </TabItem>

                <!-- 4. BÖLÜMLER -->
                <TabItem Header="Bölümler" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="White" CornerRadius="0,12,12,12" Padding="20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08" Direction="270"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="Ekle" Command="{Binding YeniBolumCommand}" Width="100" Height="40" Background="#3B82F6" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                    <Button Content="Düzenle" Command="{Binding DuzenleBolumCommand}" Width="100" Height="40" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                    <Button Content="Sil" Command="{Binding SilBolumCommand}" Width="60" Height="40" Background="#EF4444" Foreground="White" Style="{StaticResource HeaderButton}"/>
                                </StackPanel>
                                <Border Grid.Column="1" Margin="20,0,0,0" CornerRadius="20" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Height="40">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
                                        <TextBox x:Name="SearchBoxBolumler" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="5,0,15,0"
                                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                        <TextBlock Grid.Column="1" Text="Hızlı arama..." Foreground="#9CA3AF" VerticalAlignment="Center" IsHitTestVisible="False" Margin="10,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
