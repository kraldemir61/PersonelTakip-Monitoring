                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" CaretBrush="White"/>
                            <TextBlock Grid.Column="1" Text="Cihaz, seri no veya personel ara..." Foreground="#64748B" VerticalAlignment="Center" IsHitTestVisible="False" Margin="10,0,0,0"
                                     Visibility="{Binding Text.IsEmpty, ElementName=SearchBoxOlcumNew, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>
                    </Border>
                    
                    <ToggleButton Content="Boşta" Height="38" Width="100" Margin="15,0,5,0"
