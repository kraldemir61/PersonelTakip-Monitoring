                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding SantiyeListView}" SelectedItem="{Binding SelectedSantiye}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None" BorderThickness="1" BorderBrush="#E5E7EB">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Kod" Binding="{Binding Kod}" Width="100"/>
                                            <DataGridTextColumn Header="Şantiye Adı" Binding="{Binding Adi}" Width="*"/>
                                            <DataGridTextColumn Header="Adres" Binding="{Binding Adres}" Width="300"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </TabItem>

                        <!-- BÖLÜMLER -->
