                                        <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Kopyala" Click="CopyMenuItem_Click"/></ContextMenu></TextBlock.ContextMenu>
                                    </TextBlock>
                                </StackPanel>
                                
                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,15">
                                    <TextBlock Text="PERSONEL" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding ZimmetliPersonelAd, TargetNullValue='Boşta'}" Foreground="#3B82F6" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ZimmetliPersonelAd}">
                                        <TextBlock.ContextMenu><ContextMenu><MenuItem Header="Kopyala" Click="CopyMenuItem_Click"/></ContextMenu></TextBlock.ContextMenu>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                    <TextBlock Text="SAHİP FİRMA" FontSize="10" Foreground="#64748B"/>
                                    <TextBlock Text="{Binding SahipFirma}" Foreground="White"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Konum ve Detaylar Kartı -->
                    <Border Background="#1E293B" CornerRadius="12" Padding="20" Margin="0,0,0,15" BorderBrush="#334155" BorderThickness="1">
