<ColumnDefinition Width="*"/>    <!-- DataGrid -->
<ColumnDefinition Width="Auto"/> <!-- Splitter -->
<ColumnDefinition Width="320" MinWidth="250" MaxWidth="600"/> <!-- Detail Card -->
</Grid.ColumnDefinitions>
<!-- Sidebar (Admin Filter) -->
