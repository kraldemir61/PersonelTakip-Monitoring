<DataTemplate>
                        <Button Content="{Binding}" Style="{StaticResource SidebarFilterButton}"
                                Command="{Binding DataContext.OlcumSantiyeFiltreleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Tag>
                                <MultiBinding Converter="{StaticResource EqualityConverter}">
                                    <Binding Path="."/>
                                    <Binding Path="DataContext.SelectedOlcumFilterSantiye" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                </MultiBinding>
                            </Button.Tag>
                        </Button>
</DataTemplate>
</ItemsControl.ItemTemplate>
</ItemsControl>
