                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.Resources>

                        <!-- ÖLÇÜM CİHAZLARI -->
                        <TabItem Header="Ölçüm Cihazları">
                            <Border Background="White" CornerRadius="0,12,12,12" Padding="20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="320" MinWidth="250" MaxWidth="600"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <Button Content="Ekle" Command="{Binding YeniOlcumCihaziCommand}" Width="110" Height="40" Background="#10B981" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"
                                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="Düzenle" Command="{Binding DuzenleOlcumCihaziCommand}" Width="100" Height="40" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"
                                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            <Button Content="Transfer / Hareket" Command="{Binding OlcumCihaziHareketCommand}" Width="140" Height="40" Background="#3B82F6" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                            <Button Content="Geçmiş" Command="{Binding OlcumCihaziGecmisCommand}" Width="80" Height="40" Background="#6B7280" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                            <Button Content="Sil" Command="{Binding SilOlcumCihaziCommand}" Width="60" Height="40" Background="#EF4444" Foreground="White" Style="{StaticResource HeaderButton}"
                                                    Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Margin="20,0,0,0" CornerRadius="20" Background="White" BorderBrush="#E5E7EB" BorderThickness="1" Height="40">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
                                                <TextBox x:Name="SearchBoxOlcum" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="5,0,15,0"
                                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Column="1" Text="Seri no, marka, model ara..." Foreground="#9CA3AF" VerticalAlignment="Center" IsHitTestVisible="False" Margin="10,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBoxOlcum}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <DataGrid Grid.Row="1" Grid.Column="0" ItemsSource="{Binding OlcumCihazlariView}" SelectedItem="{Binding SelectedOlcumCihazi}" 
                                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None" BorderThickness="1" BorderBrush="#E5E7EB" Margin="0,0,5,0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Seri No" Binding="{Binding SeriNo}" Width="120"/>
                                            <DataGridTextColumn Header="Cihaz Adı" Binding="{Binding CihazAdi}" Width="120"/>
                                            <DataGridTextColumn Header="Marka" Binding="{Binding Marka}" Width="100"/>
                                            <DataGridTextColumn Header="Durum" Binding="{Binding Durum}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <GridSplitter Grid.Row="1" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True" Cursor="SizeWE" Margin="0,0,5,0"/>

                                    <Border Grid.Row="1" Grid.Column="2" Background="#FFFFFF" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="15" Margin="5,0,0,0">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.05" Direction="270" Color="#000000"/>
                                        </Border.Effect>
                                        <Grid>
                                            <!-- CİHAZ DETAY -->
                                            <StackPanel Visibility="{Binding SelectedOlcumCihazi, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                                                <Border Width="60" Height="60" Background="#DCFCE7" CornerRadius="40" Margin="0,0,0,5">
                                                    <TextBlock Text="🛠️" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <TextBlock Text="{Binding SelectedOlcumCihazi.CihazAdi}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                                
                                                <Separator Margin="0,0,0,20"/>
                                                
                                                <StackPanel>
                                                    <TextBlock Text="MARKA / MODEL" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                        <TextBlock Text="{Binding SelectedOlcumCihazi.Marka}" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text=" / " Foreground="#9CA3AF"/>
                                                        <TextBlock Text="{Binding SelectedOlcumCihazi.Model}" FontSize="14"/>
                                                    </StackPanel>

                                                    <TextBlock Text="SAHİP FİRMA" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding SelectedOlcumCihazi.SahipFirma}" FontSize="14" Margin="0,0,0,12"/>

                                                    <TextBlock Text="BULUNDUĞU YER" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding SelectedOlcumCihazi.SantiyeKod}" FontSize="14" FontWeight="Bold" Foreground="#1E2937" Margin="0,0,0,12"/>

                                                    <TextBlock Text="DURUM" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                    <Border Background="#F3F4F6" HorizontalAlignment="Left" Padding="10,4" CornerRadius="4" Margin="0,0,0,12">
                                                        <TextBlock Text="{Binding SelectedOlcumCihazi.Durum}" FontSize="13" FontWeight="SemiBold" Foreground="#374151"/>
                                                    </Border>

                                                    <TextBlock Text="SON İŞLEM" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding SelectedOlcumCihazi.SonIslemTarihi, StringFormat=dd.MM.yyyy HH:mm}" FontSize="14" Margin="0,0,0,12"/>

                                                    <TextBlock Text="NOT" FontSize="10" FontWeight="Bold" Foreground="#9CA3AF" Margin="0,0,0,2"/>
                                                    <TextBlock Text="{Binding SelectedOlcumCihazi.Not}" FontSize="13" TextWrapping="Wrap" Opacity="0.8"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- GENEL DURUM ÖZETİ (Cihaz Seçili Değilse) -->
                                            <Grid Visibility="{Binding SelectedOlcumCihazi, Converter={StaticResource NullToVisibilityConverter}}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Ölçüm Cihazları Özeti" FontSize="18" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,15"/>
                                                
                                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel>
                                                        <Border CornerRadius="8" Padding="15" Margin="0,0,0,15">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#ECFDF5" Offset="0.0"/>
                                                                    <GradientStop Color="#D1FAE5" Offset="1.0"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                            <StackPanel>
                                                                <TextBlock Text="Toplam Ölçüm Cihazı" FontSize="13" FontWeight="SemiBold" Foreground="#059669"/>
                                                                <TextBlock Text="{Binding ToplamOlcumCihazi}" FontSize="28" FontWeight="Bold" Foreground="#064E3B" Margin="0,5,0,0"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <TextBlock Text="Cihaz Dağılımı" FontSize="14" FontWeight="SemiBold" Foreground="#4B5563" Margin="0,0,0,10"/>
                                                        <ItemsControl ItemsSource="{Binding OlcumCihaziStats}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8" Padding="10">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#374151"/>
                                                                            <TextBlock Grid.Column="1" Text="{Binding Count}" FontWeight="Bold" Foreground="#059669"/>
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </ScrollViewer>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </TabItem>

                        <!-- OFİS CİHAZLARI -->
                        <TabItem Header="Ofis Cihazları">
                            <Border Background="#F8FAFC" CornerRadius="0,12,12,12" Padding="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="320"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- ─── SOL: Cihaz Listesi ─── -->
                                    <Grid Grid.Column="0" Margin="15">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Filtreler -->
                                        <UniformGrid Grid.Row="0" Columns="2" Margin="0,0,0,10">
                                            <ToggleButton Content="Boşta" Height="32" Margin="0,0,5,0"
                                                          IsChecked="{Binding OfisCihaziFilterAvailable}"
                                                          Style="{StaticResource SidebarFilterToggleButton}"/>
                                            <ToggleButton Content="Zimmetli" Height="32" Margin="5,0,0,0"
                                                          IsChecked="{Binding OfisCihaziFilterAssigned}"
                                                          Style="{StaticResource SidebarFilterToggleButton}"/>
                                        </UniformGrid>

                                        <!-- Arama -->
                                        <Border Grid.Row="1" CornerRadius="10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" Height="38" Margin="0,0,0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="35"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5"/>
                                                <TextBox x:Name="SearchBoxOfisNew" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="5,0,10,0"
                                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                                                <TextBlock Grid.Column="1" Text="Cihaz veya personel ara..." Foreground="#9CA3AF" VerticalAlignment="Center" IsHitTestVisible="False" Margin="10,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=SearchBoxOfisNew}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <!-- DataGrid (Sidebar List) -->
                                        <!-- List Header -->
                                        <Grid Grid.Row="2" Margin="5,0,5,10">
                                            <TextBlock Text="Cihaz Listesi" VerticalAlignment="Center" Foreground="#EF4444" FontWeight="Bold" FontSize="14"/>
                                            <Button Command="{Binding YeniOfisCihaziCommand}"
                                                    Width="60" Height="32" HorizontalAlignment="Right" 
                                                    Content="Ekle" FontSize="14" Foreground="White" BorderThickness="0" Cursor="Hand"
                                                    ToolTip="Yeni Ofis Cihazı Ekle"
                                                    Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#10B981"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,-3,0,0"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#059669"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <Border Grid.Row="3" Background="White" CornerRadius="12" BorderBrush="#E2E8F0" BorderThickness="1" Padding="2">
                                            <DataGrid ItemsSource="{Binding OfisCihazlariView}" SelectedItem="{Binding SelectedOfisCihazi}" 
                                                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="None" AlternationCount="2">
                                                <DataGrid.Columns>
                                                    <DataGridTemplateColumn Width="*">
                                                        <DataGridTemplateColumn.CellTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="10,5">
                                                                    <TextBlock Text="{Binding CihazAdi}" FontWeight="Bold" FontSize="13">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#1E293B"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                                        <Setter Property="Foreground" Value="Blue"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Marka}" FontSize="11">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                                            <Setter Property="Foreground" Value="Blue"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text=" " />
                                                                        <TextBlock Text="{Binding Model}" FontSize="11">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock">
                                                                                    <Setter Property="Foreground" Value="#64748B"/>
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                                            <Setter Property="Foreground" Value="Blue"/>
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{Binding ZimmetliPersonelAd, TargetNullValue='Boşta'}" FontSize="11" FontWeight="SemiBold">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ZimmetliMi}" Value="True">
                                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                                                        <Setter Property="Foreground" Value="Blue"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </DataGridTemplateColumn.CellTemplate>
                                                    </DataGridTemplateColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Border>
                                </Grid>

                                    <!-- ─── SAĞ: Detay Kartı ─── -->
                                    <Grid Grid.Column="1" Margin="0,15,15,15">
                                        <!-- Empty State -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedOfisCihazi}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="📱" FontSize="60" HorizontalAlignment="Center" Opacity="0.2"/>
                                            <TextBlock Text="Detayları görmek için bir cihaz seçin" Foreground="#94A3B8" FontSize="16" FontStyle="Italic" Margin="0,10,0,0"/>
                                        </StackPanel>

                                        <!-- Detail Content -->
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ScrollViewer.Style>
                                                <Style TargetType="ScrollViewer">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedOfisCihazi}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ScrollViewer.Style>

                                            <StackPanel DataContext="{Binding SelectedOfisCihazi}">
                                                <!-- Header Card -->
                                                <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,0,15">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Width="60" Height="60" CornerRadius="30" Background="#F1F5F9" Margin="0,0,20,0">
                                                            <TextBlock Text="📱" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding CihazAdi}" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                            <Button Content="Düzenle" Command="{Binding DataContext.DuzenleOfisCihaziCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Padding="15,6" Background="#F59E0B" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                            </Button>
                                                            <Button Content="Sil" Command="{Binding DataContext.SilOfisCihaziCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    Padding="15,6" Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Cursor="Hand">
                                                                <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>

                                                <UniformGrid Columns="2">
                                                    <!-- Left Column: Photos & Info -->
                                                    <StackPanel Margin="0,0,8,0">
                                                        <!-- Photos Card -->
                                                        <Border Background="White" CornerRadius="15" Padding="15" Margin="0,0,0,15">
                                                            <StackPanel>
                                                                <TextBlock Text="CİHAZ BİLGİLERİ" FontWeight="Bold" FontSize="11" Foreground="#2563EB" Margin="0,0,0,15"/>
                                                                
                                                                <StackPanel Margin="5,0">
                                                                    <TextBlock Text="MARKA / MODEL" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                                                        <TextBlock Text="{Binding Marka}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B"/>
                                                                        <TextBlock Text=" " />
                                                                        <TextBlock Text="{Binding Model}" FontSize="14" Foreground="#1E293B"/>
                                                                    </StackPanel>

                                                                    <TextBlock Text="SERİ NO" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                                                    <TextBlock Text="{Binding SeriNo}" FontSize="14" FontWeight="SemiBold" Foreground="#1E293B" Margin="0,0,0,12"/>
                                                                    
                                                                    <TextBlock Text="ÖZELLİKLER" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4"/>
                                                                    <TextBlock Text="{Binding Ozellik}" FontSize="13" TextWrapping="Wrap" Foreground="#475569" Margin="0,0,0,12"/>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>

                                                        <!-- Description Card -->
                                                        <Border Background="White" CornerRadius="15" Padding="15">
                                                            <StackPanel>
                                                                <TextBlock Text="AÇIKLAMA / NOT" FontWeight="Bold" FontSize="11" Foreground="#2563EB" Margin="0,0,0,10"/>
                                                                <TextBlock Text="{Binding Not, TargetNullValue='(Not girilmemiş)'}" Foreground="#475569" TextWrapping="Wrap" FontSize="13" FontStyle="Italic"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>

                                                    <!-- Right Column: Zimmet -->
                                                    <StackPanel Margin="8,0,0,0">
                                                        <!-- Zimmet Card -->
                                                        <Border Background="White" CornerRadius="15" Padding="20">
                                                            <StackPanel>
                                                                <TextBlock Text="ZİMMET BİLGİLERİ" FontWeight="Bold" FontSize="11" Foreground="#2563EB" Margin="0,0,0,20"/>
                                                                
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Grid.Column="0" Width="50" Height="50" CornerRadius="25" Background="#E2E8F0" Margin="0,0,15,0">
                                                                        <TextBlock Text="👤" FontSize="25" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>

                                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                        <TextBlock Text="Mevcut Personel" FontSize="11" Foreground="#64748B" Margin="0,0,0,2"/>
                                                                        <TextBlock Text="{Binding ZimmetliPersonelAd, TargetNullValue='- Zimmet Yok -'}" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding ZimmetliMi, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <TextBlock Text="Zimmet Tarihi: " FontSize="11" Foreground="#64748B"/>
                                                                            <TextBlock Text="{Binding ZimmetTarihi, StringFormat=d}" FontSize="11" Foreground="#1E293B" FontWeight="SemiBold"/>
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">
                                                                    <Button Content="İADE AL" Width="100" Height="32" Background="#EF4444" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand" Margin="0,0,10,0"
                                                                            Command="{Binding DataContext.IadeAlOfisCihaziCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                                            Visibility="{Binding ZimmetliMi, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                                    </Button>
                                                                    <Button Content="ZİMMETLE" Width="100" Height="32" Background="#2563EB" Foreground="White" BorderThickness="0" FontWeight="Bold" Cursor="Hand"
                                                                            Command="{Binding DataContext.ZimmetleOfisCihaziCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                                                        <Button.Style>
                                                                            <Style TargetType="Button">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ZimmetliMi}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Button.Style>
                                                                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="6"/></Style></Button.Resources>
                                                                    </Button>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>
                                        </ScrollViewer>
                                    </Grid>
                                </Grid>
                            </Border>
                        </TabItem>

                        <!-- CİHAZ TANIMLAMALARI -->
                        <TabItem Header="Cihaz Tanımlamalar" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Border Background="White" CornerRadius="0,12,12,12" Padding="20">
                                <TabControl Background="Transparent" BorderThickness="0" Margin="0">
                                    <TabControl.Resources>
                                        <Style TargetType="TabItem">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TabItem">
                                                        <Border x:Name="TabBorder" Background="#F1F5F9" Padding="15,6" CornerRadius="4" Margin="0,0,5,0">
                                                            <ContentPresenter x:Name="ContentSite" ContentSource="Header"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="TabBorder" Property="Background" Value="#3B82F6"/>
                                                                <Setter Property="Foreground" Value="White"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Foreground" Value="#475569"/>
                                        </Style>
                                    </TabControl.Resources>

                                    <!-- Cihaz Adı -->
                                    <TabItem Header="Cihaz Adı">
                                        <Grid Margin="0,15,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                                <Button Content="Ekle" Command="{Binding YeniCihazAdCommand}" Width="100" Height="35" Background="#10B981" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                                <Button Content="Düzenle" Command="{Binding DuzenleCihazAdCommand}" Width="100" Height="35" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                                <Button Content="Sil" Command="{Binding SilCihazAdCommand}" Width="60" Height="35" Background="#EF4444" Foreground="White" Style="{StaticResource HeaderButton}"/>
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding CihazAdlariView}" SelectedItem="{Binding SelectedCihazAd}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#E5E7EB">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Cihaz Adı" Binding="{Binding Adi}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>

                                    <!-- Marka -->
                                    <TabItem Header="Marka">
                                        <Grid Margin="0,15,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                                <Button Content="Ekle" Command="{Binding YeniMarkaCommand}" Width="100" Height="35" Background="#10B981" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                                <Button Content="Düzenle" Command="{Binding DuzenleMarkaCommand}" Width="100" Height="35" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                                <Button Content="Sil" Command="{Binding SilMarkaCommand}" Width="60" Height="35" Background="#EF4444" Foreground="White" Style="{StaticResource HeaderButton}"/>
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding MarkalarView}" SelectedItem="{Binding SelectedMarka}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#E5E7EB">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Marka" Binding="{Binding Adi}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>

                                    <!-- Model -->
                                    <TabItem Header="Model">
                                        <Grid Margin="0,15,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                                <Button Content="Ekle" Command="{Binding YeniModelCommand}" Width="100" Height="35" Background="#10B981" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                                <Button Content="Düzenle" Command="{Binding DuzenleModelCommand}" Width="100" Height="35" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                                <Button Content="Sil" Command="{Binding SilModelCommand}" Width="60" Height="35" Background="#EF4444" Foreground="White" Style="{StaticResource HeaderButton}"/>
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding ModellerView}" SelectedItem="{Binding SelectedModel}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#E5E7EB">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Model" Binding="{Binding Adi}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>

                                    <!-- Firma -->
                                    <TabItem Header="Firma">
                                        <Grid Margin="0,15,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                                                <Button Content="Ekle" Command="{Binding YeniFirmaCommand}" Width="100" Height="35" Background="#10B981" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                                <Button Content="Düzenle" Command="{Binding DuzenleFirmaCommand}" Width="100" Height="35" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                                <Button Content="Sil" Command="{Binding SilFirmaCommand}" Width="60" Height="35" Background="#EF4444" Foreground="White" Style="{StaticResource HeaderButton}"/>
                                            </StackPanel>
                                            <DataGrid Grid.Row="1" ItemsSource="{Binding FirmalarView}" SelectedItem="{Binding SelectedFirma}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#E5E7EB">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="Firma" Binding="{Binding Adi}" Width="*"/>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Border>
                        </TabItem>
                    </TabControl>
                </TabItem>

                <!-- 8. TOPLU İŞLEMLER (Excel) -->
                <TabItem Header="Toplu İşlemler" Visibility="{Binding IsSuperAdmin, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Border Background="White" CornerRadius="0,12,12,12" Padding="30">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.08" Direction="270"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                                <TextBlock Text="Excel ile Toplu İşlemler" FontSize="24" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,10"/>
                                <TextBlock Text="Bu bölümden Excel şablonları kullanarak sisteme toplu veri ekleyebilir veya mevcut verileri güncelleyebilirsiniz." 
                                           FontSize="14" Foreground="#6B7280" TextWrapping="Wrap" Margin="0,0,0,30"/>

                                <!-- VERİTABANI İŞLEMLERİ GRUBU -->
                                <Border Background="#F1F5F9" CornerRadius="12" Padding="20" Margin="0,0,0,30">
                                    <StackPanel>
                                        <TextBlock Text="Veritabanı İşlemleri" FontSize="18" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,20"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="💾 Veritabanı Yedekle" Command="{Binding BackupDatabaseCommand}" IsEnabled="{Binding IsDatabaseBusy, Converter={StaticResource InverseBoolConverter}}" Height="40" Background="#6366F1" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="📂 Veritabanı Yükle" Command="{Binding RestoreDatabaseCommand}" IsEnabled="{Binding IsDatabaseBusy, Converter={StaticResource InverseBoolConverter}}" Height="40" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                        </Grid>
                                        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,15,0,0" Visibility="{Binding IsDatabaseBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </Border>

                                <!-- PERSONEL İŞLEMLERİ GRUBU -->
                                <Border Background="#F1F5F9" CornerRadius="12" Padding="20" Margin="0,0,0,30">
                                    <StackPanel>
                                        <TextBlock Text="Personel İşlemleri" FontSize="18" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,20"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="📄 Boş Şablon" Command="{Binding ExcelSablonIndirCommand}" Height="40" Background="#3B82F6" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="📥 Toplu Ekle" Command="{Binding ExcelTopluYukleCommand}" Height="40" Background="#10B981" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                            <Button Grid.Column="2" Content="📤 Verileri İndir" Command="{Binding ExcelDisariAktarCommand}" Height="40" Background="#6366F1" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                            <Button Grid.Column="3" Content="🔄 Toplu Güncelle" Command="{Binding ExcelTopluGuncelleCommand}" Height="40" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CİHAZ İŞLEMLERİ GRUBU -->
                                <Border Background="#F1F5F9" CornerRadius="12" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="Ölçüm Cihazı İşlemleri" FontSize="18" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,20"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="📄 Boş Şablon" Command="{Binding ExcelCihazSablonIndirCommand}" Height="40" Background="#3B82F6" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                            <Button Grid.Column="1" Content="📥 Toplu Ekle" Command="{Binding ExcelCihazTopluYukleCommand}" Height="40" Background="#10B981" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                            <Button Grid.Column="2" Content="📤 Verileri İndir" Command="{Binding ExcelCihazDisariAktarCommand}" Height="40" Background="#6366F1" Foreground="White" Style="{StaticResource HeaderButton}" Margin="0,0,10,0"/>
                                            <Button Grid.Column="3" Content="🔄 Toplu Güncelle" Command="{Binding ExcelCihazTopluGuncelleCommand}" Height="40" Background="#F59E0B" Foreground="White" Style="{StaticResource HeaderButton}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <!-- SİSTEM SIFIRLAMA -->
                                <Border Background="#FEF2F2" BorderBrush="#FEE2E2" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,30,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Sistem Sıfırlama" FontSize="18" FontWeight="Bold" Foreground="#991B1B" Margin="0,0,0,10"/>
                                        <TextBlock Text="DİKKAT: Bu işlem tüm personel, cihaz ve hareket geçmişi verilerini kalıcı olarak siler. Tanımlamalar korunur." 
                                                   FontSize="13" Foreground="#B91C1C" Margin="0,0,0,20"/>
                                        <Button Content="⚠️ VERİTABANINI TEMİZLE" Command="{Binding ResetDatabaseCommand}" 
                                                Height="45" Width="250" Background="#EF4444" Foreground="White" 
                                                Style="{StaticResource HeaderButton}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </TabItem>

            </TabControl>

        <Button Grid.Row="1" Content="Çıkış" Height="28" Width="70" FontSize="11" FontWeight="SemiBold" 
                Command="{Binding LogoutCommand}" Background="#EF4444" Foreground="White" 
                Style="{StaticResource HeaderButton}" HorizontalAlignment="Right" VerticalAlignment="Top" 
                Margin="0,8,30,0" Panel.ZIndex="10"/>
            



        <!-- Status Bar -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="14,0,20,10" Padding="20,10">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding ConnectionStatus}" Foreground="#64748B" FontSize="12"/>
                </StackPanel>
                <TextBlock Text="Test@system.local" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
        <!-- Global Notification Snackbar -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,40"
                Background="#3B82F6" CornerRadius="6" Padding="15,10"
                Grid.RowSpan="2" Panel.ZIndex="999" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <TranslateTransform Y="20"/>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNotificationVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="0" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.Y" To="20" Duration="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <QuadraticEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔔" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding NotificationMessage}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
