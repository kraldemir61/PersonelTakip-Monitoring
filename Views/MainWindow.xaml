                            <TextBlock Text="KONUM VE DETAYLAR" FontWeight="Bold" FontSize="11" Foreground="#10B981" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Background="#3B82F6" Width="4" CornerRadius="2" Margin="0,2,12,2"/>
