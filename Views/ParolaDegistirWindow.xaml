<Window x:Class="PersonelTakip.Views.ParolaDegistirWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PersonelTakip.Controls"
        Title="Şifremi Değiştir" Height="465" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource ModernDialogStyle}">
    <Window.Resources>
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="45"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}"
                                           Foreground="#9CA3AF" Margin="12,0" 
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Visibility="Visible"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <controls:CustomTitleBar Grid.Row="0" CanMaximize="False"/>
        
        <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="15" Padding="20">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.1"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Şifremi Değiştir" FontSize="20" FontWeight="Bold" Foreground="#111827" Margin="0,0,0,5"/>
                    <TextBlock Text="Güvenliğiniz için şifrenizi güncelleyin." FontSize="13" Foreground="#6B7280" Margin="0,0,0,20"/>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <PasswordBox x:Name="TxtEski" Tag="Mevcut Şifre" PasswordChanged="TxtEski_PasswordChanged" Style="{StaticResource ModernPasswordBox}"/>
                    <PasswordBox x:Name="TxtYeni" Tag="Yeni Şifre" PasswordChanged="TxtYeni_PasswordChanged" Style="{StaticResource ModernPasswordBox}"/>
                    <PasswordBox x:Name="TxtYeniTekrar" Tag="Yeni Şifre (Tekrar)" PasswordChanged="TxtYeniTekrar_PasswordChanged" Style="{StaticResource ModernPasswordBox}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                    <Button Content="Güncelle" Command="{Binding KaydetCommand}" Background="#3B82F6" Foreground="White" Style="{StaticResource ModernButton}" Width="100" Height="36"/>
                    <Button Content="İptal" Command="{Binding IptalCommand}" Background="#F3F4F6" Foreground="#374151" Style="{StaticResource ModernButton}" Width="100" Height="36"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
