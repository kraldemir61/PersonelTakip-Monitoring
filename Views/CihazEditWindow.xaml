<Window x:Class="PersonelTakip.Views.CihazEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PersonelTakip.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="550" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <conv:FotoPathToImageConverter x:Key="FotoPathToImageConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#1E2937" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Seri Numarası" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <TextBox Text="{Binding SeriNo, UpdateSourceTrigger=PropertyChanged}" Height="35" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>

                <TextBlock Text="Cihaz Adı" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox Text="{Binding CihazAdi, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding CihazAdlari}" 
                          DisplayMemberPath="Adi" SelectedValuePath="Adi" IsEditable="True"
                          Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Markası" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox Text="{Binding Marka, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Markalar}" 
                          DisplayMemberPath="Adi" SelectedValuePath="Adi" IsEditable="True"
                          Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Modeli" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Modeller}" 
                          DisplayMemberPath="Adi" SelectedValuePath="Adi" IsEditable="True"
                          Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Sahip Firma" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox Text="{Binding SahipFirma, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Firmalar}" 
                          DisplayMemberPath="Adi" SelectedValuePath="Adi" IsEditable="True" IsEnabled="{Binding IsSuperAdmin}"
                          Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Bulunduğu Yer (Şantiye)" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox ItemsSource="{Binding SantiyeList}" SelectedValue="{Binding SantiyeId}" 
                          SelectedValuePath="Id" DisplayMemberPath="Kod"
                          Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Özellikler / Spesifikasyonlar" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Ozellik, UpdateSourceTrigger=PropertyChanged}" Height="35" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>

                <TextBlock Text="Not / Zimmet Bilgisi" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Not, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,5" Margin="0,0,0,15"/>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="İptal" Command="{Binding IptalCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                    Width="100" Height="40" Background="#E2E8F0" Foreground="#475569" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="Kaydet" Command="{Binding KaydetCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                    Width="100" Height="40" Background="#3B82F6" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
