<Window x:Class="PersonelTakip.Views.CihazHareketWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cihaz Hareket / Transfer" Height="400" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Cihaz Hareket / Transfer" FontSize="20" FontWeight="Bold" Foreground="#1E2937"/>
            <TextBlock Text="{Binding CihazBilgi}" FontSize="12" Foreground="#64748B" Margin="0,5,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="İşlem Türü" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding IslemTurleri}" SelectedItem="{Binding IslemTuru}" Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Nereye (Şantiye / Konum)" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
            <ComboBox ItemsSource="{Binding SantiyeList}" SelectedValue="{Binding NereyeSantiyeId}" 
                      SelectedValuePath="Id" DisplayMemberPath="Kod"
                      Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock Text="Açıklama" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
            <TextBox Text="{Binding Aciklama, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,5"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="İptal" Command="{Binding IptalCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                    Width="100" Height="40" Background="#E2E8F0" Foreground="#475569" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="Kaydet" Command="{Binding KaydetCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                    Width="100" Height="40" Background="#3B82F6" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
