<Window x:Class="PersonelTakip.Monitoring.Views.BildirimMerkeziWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PersonelTakip.Monitoring.Views"
        mc:Ignorable="d"
        Title="Bildirim Merkezi" Height="600" Width="450"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Border Background="#0F172A" CornerRadius="15" BorderBrush="#1E293B" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#1E293B" CornerRadius="15,15,0,0" MouseLeftButtonDown="Header_MouseDown">
                <Grid Margin="20,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="M18 8A6 6 0 0 0 6 8C6 15 3 17 3 17H21C21 17 18 15 18 8 M13.73 21A2 2 0 0 1 10.27 21" 
                              Stretch="Uniform" Fill="#3B82F6" Width="18" Height="18" Margin="0,0,12,0"/>
                        <TextBlock Text="Bildirim Merkezi" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding TumunuSilCommand}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0">
                            <TextBlock Text="Tümünü Sil" Foreground="#EF4444" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Button Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="✕" Foreground="#94A3B8" FontSize="18" FontWeight="Bold"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1">
                <!-- Empty State -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,50">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Bildirimler.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Path Data="M13 16H12V12H11 M12 8H12.01 M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" 
                          Stretch="Uniform" Fill="#1E293B" Width="64" Height="64" Margin="0,0,0,15"/>
                    <TextBlock Text="Henüz bildirim bulunmuyor" Foreground="#475569" FontSize="14" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- List -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10,10,5,10">
                    <ItemsControl ItemsSource="{Binding Bildirimler}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E293B" CornerRadius="10" Margin="10,5" Padding="15">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="0.6"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding OkunduMu}" Value="False">
                                                    <Setter Property="Opacity" Value="1"/>
                                                    <Setter Property="BorderBrush" Value="#3B82F6"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel>
                                            <TextBlock Text="{Binding Mesaj}" Foreground="White" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                            <TextBlock Text="{Binding Tarih, StringFormat='dd.MM.yyyy HH:mm'}" Foreground="#64748B" FontSize="11"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Command="{Binding DataContext.OkunduİsaretleCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand" Margin="0,0,10,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OkunduMu}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Path Data="M5 13l4 4L19 7" Stretch="Uniform" Fill="#10B981" Width="14" Height="14"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.BildirimSilCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                                    CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                                <TextBlock Text="✕" Foreground="#64748B" FontSize="14" FontWeight="Bold"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#1E293B" CornerRadius="0,0,15,15" Padding="15">
                <Button Content="Kapat" Click="Close_Click" Background="#334155" Foreground="White" 
                        Padding="25,8" BorderThickness="0" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Border>
        </Grid>
    </Border>
</Window>
