<Window x:Class="PersonelTakip.Monitoring.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lisans Doğrulama" Height="480" Width="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border Background="#0F172A" CornerRadius="20" BorderBrush="#334155" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid Margin="35">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="Lisans Doğrulama" Foreground="White" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Lütfen geçerli bir lisans anahtarı girin" Foreground="#94A3B8" FontSize="13" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1">
                <TextBlock Text="DONANIM KİMLİĞİ (HARDWARE ID)" Foreground="#3B82F6" FontSize="11" FontWeight="Bold" Margin="5,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#1E293B" Height="45" CornerRadius="10" Padding="12,0" BorderBrush="#334155" BorderThickness="1">
                        <TextBox x:Name="TxtHardwareId" Text="Loading..." IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="#3B82F6" VerticalContentAlignment="Center" FontSize="16" FontWeight="Bold"/>
                    </Border>
                    <Button Grid.Column="1" Content="Kopyala" Click="BtnCopy_Click" Margin="8,0,0,0" Padding="15,0" Foreground="White" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#475569"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <TextBlock Text="LİSANS ANAHTARI" Foreground="#3B82F6" FontSize="11" FontWeight="Bold" Margin="5,25,0,8"/>
                <Border Background="#1E293B" CornerRadius="10" Padding="12" BorderBrush="#334155" BorderThickness="1">
                    <TextBox x:Name="TxtLicenseKey" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="18" CharacterCasing="Upper" HorizontalContentAlignment="Center" CaretBrush="White"/>
                </Border>
            </StackPanel>

            <!-- Status Message -->
            <TextBlock x:Name="TxtStatus" Grid.Row="2" Foreground="#F87171" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15" FontWeight="SemiBold"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="3">
                <!-- ETKİNLEŞTİR -->
                <Button x:Name="BtnActivate" Content="ETKİNLEŞTİR" Click="BtnActivate_Click" Height="50" Foreground="White" FontWeight="Bold" FontSize="15" BorderThickness="0" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#10B981"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#059669"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Grid Margin="0,15,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button x:Name="BtnTrial" Grid.Column="0" Content="7 Günlük Deneme" Click="BtnTrial_Click" Height="40" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="12" FontWeight="SemiBold">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#F59E0B"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D97706"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    
                    <Button Grid.Column="2" Content="Kapat" Click="BtnClose_Click" Height="40" Width="100" Margin="10,0,0,0" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" FontSize="13">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#334155"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EF4444"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
