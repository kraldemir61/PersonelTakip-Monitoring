<Window x:Class="PersonelTakip.Views.OfisCihazEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:PersonelTakip.Converters"
        mc:Ignorable="d"
        Title="{Binding Title}" Height="650" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#F8FAFC">
    <Window.Resources>
        <ResourceDictionary>
            <conv:FotoPathToImageConverter x:Key="FotoPathToImageConverter"/>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" Foreground="#1E2937" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Seri Numarası" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <TextBox Text="{Binding SeriNo, UpdateSourceTrigger=PropertyChanged}" Height="35" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>

                <TextBlock Text="Cihaz Adı" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox Text="{Binding CihazAdi, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding CihazAdlari}" 
                          DisplayMemberPath="Adi" SelectedValuePath="Adi" IsEditable="True"
                          Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Markası" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox Text="{Binding Marka, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Markalar}" 
                          DisplayMemberPath="Adi" SelectedValuePath="Adi" IsEditable="True"
                          Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Modeli" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <ComboBox Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Modeller}" 
                          DisplayMemberPath="Adi" SelectedValuePath="Adi" IsEditable="True"
                          Height="35" VerticalContentAlignment="Center" Margin="0,0,0,15"/>

                <TextBlock Text="Özellikler / Spesifikasyonlar" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Ozellik, UpdateSourceTrigger=PropertyChanged}" Height="35" VerticalContentAlignment="Center" Padding="10,0" Margin="0,0,0,15"/>

                <TextBlock Text="Cihaz Notu / Açıklama" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <TextBox Text="{Binding Not, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="10,5" Margin="0,0,0,15"/>

                <!-- Fotoğraflar Bölümü -->
                <TextBlock Text="Cihaz Fotoğrafları (En fazla 3)" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Background="White">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Fotograflar}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" CornerRadius="4" Background="#F1F5F9" Margin="0,0,10,0">
                                            <Image Source="{Binding Converter={StaticResource FotoPathToImageConverter}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="#64748B"/>
                                        <Button Grid.Column="2" Content="✕" Width="24" Height="24" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand"
                                                Command="{Binding DataContext.RemoveFotoCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="+ Fotoğraf Ekle" Command="{Binding SelectFotoCommand}" Height="30" Margin="0,5,0,0"
                                Background="Transparent" Foreground="#3B82F6" BorderBrush="#3B82F6" BorderThickness="1" Cursor="Hand">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="4"/></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="İptal" Command="{Binding IptalCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                    Width="100" Height="40" Background="#E2E8F0" Foreground="#475569" BorderThickness="0" Margin="0,0,10,0"/>
            <Button Content="Kaydet" Command="{Binding KaydetCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                    Width="100" Height="40" Background="#3B82F6" Foreground="White" BorderThickness="0"/>
        </StackPanel>
    </Grid>
</Window>
