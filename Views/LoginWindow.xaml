<Window x:Class="PersonelTakip.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PersonelTakip.Controls"
        Title="Personel Takip Sistemi - Giriş" Height="580" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Style="{StaticResource ModernWindowStyle}"
        Loaded="Window_Loaded">

    <Window.InputBindings>
        <KeyBinding Key="C" Modifiers="Ctrl+Shift" Command="{Binding OpenDatabaseSettingsCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <!-- Modern Input Styles -->
        <Style x:Key="ModernInput" TargetType="Control">
            <Setter Property="Height" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,2"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernInput}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource ModernInput}">
             <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="30"/>
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="12,0,0,0" VerticalAlignment="Center" 
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                    <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="#6B7280" StrokeThickness="2"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="ToggleButton" ClickMode="Press" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent" BorderThickness="0"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"
                                   MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Background="White" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Margin="0,2,0,0">
                                    <ScrollViewer MaxHeight="200">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Border" Property="Background" Value="#F3F4F6"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Form Label Style -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>

        <!-- Segmented Toggle Style -->
        <Style x:Key="SegmentButton" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Border" Background="Transparent" 
                                BorderThickness="0,0,0,2" BorderBrush="Transparent"
                                Padding="20,10" Cursor="Hand">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#6B7280"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <controls:CustomTitleBar Grid.Row="0"/>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Margin="25" Padding="25">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.1"/>
            </Border.Effect>
            
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Logo Section -->
                    <RowDefinition Height="Auto"/> <!-- Toggle Section -->
                    <RowDefinition Height="*"/>    <!-- Content Section -->
                    <RowDefinition Height="Auto"/> <!-- Status Section -->
                </Grid.RowDefinitions>

                <!-- 1. Logo Section -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="PERSONEL VE ZİMMET TAKİBİ" FontSize="17" FontWeight="Bold" Foreground="#1F2937" HorizontalAlignment="Center"/>
                    <TextBlock Text="Akıllı Yönetim Sistemi" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- 2. Toggle Section -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <RadioButton x:Name="RbKayit" Content="Kayıt Ol" GroupName="ST" Style="{StaticResource SegmentButton}" Checked="RbKayit_Checked"/>
                    <RadioButton x:Name="RbGiris" Content="Giriş Yap" IsChecked="True" GroupName="ST" Style="{StaticResource SegmentButton}" Checked="RbGiris_Checked"/>
                </StackPanel>

                <!-- 3. Content Section -->
                <Grid Grid.Row="2">
                    <!-- LOGIN PANEL -->
                    <StackPanel x:Name="PanelGiris" Visibility="Visible" VerticalAlignment="Top">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Kullanıcı Adı" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtEmail" Grid.Column="1" Text="{Binding LoginKullaniciAdi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Parola" Style="{StaticResource FormLabel}"/>
                            <PasswordBox x:Name="TxtPassword" Grid.Column="1" Style="{StaticResource ModernPasswordBox}"/>
                        </Grid>
                        <CheckBox Content="Beni Hatırla" IsChecked="{Binding RememberMe}" Margin="80,0,0,15" FontSize="12" Foreground="#6B7280"/>
                        <Button Content="Giriş Yap" IsDefault="True" Click="BtnGiris_Click" Style="{StaticResource PrimaryButton}" Height="42"/>
                    </StackPanel>

                    <!-- REGISTER PANEL -->
                    <StackPanel x:Name="PanelKayit" Visibility="Collapsed" VerticalAlignment="Top">
                        <!-- 1. Şantiye -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Şantiye" Style="{StaticResource FormLabel}"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding SantiyeList}" 
                                      SelectedValue="{Binding RegisterSantiyeId}" SelectedValuePath="Id" 
                                      Style="{StaticResource ModernComboBox}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Kod}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                        <!-- 2. Kullanıcı Adı -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Kullanıcı Adı" Style="{StaticResource FormLabel}"/>
                            <TextBox x:Name="TxtKullaniciAdi" Grid.Column="1" Text="{Binding RegisterKullaniciAdi, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}"/>
                        </Grid>
                        <!-- 3. Parola -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Parola" Style="{StaticResource FormLabel}"/>
                            <PasswordBox x:Name="TxtRegisterSifre" Grid.Column="1" Style="{StaticResource ModernPasswordBox}"/>
                        </Grid>
                        <!-- 4. Parola Tekrar -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Parola Tekrar" Style="{StaticResource FormLabel}"/>
                            <PasswordBox x:Name="TxtRegisterSifreTekrar" Grid.Column="1" Style="{StaticResource ModernPasswordBox}"/>
                        </Grid>
                        <Button Content="Kayıt Ol" Click="BtnKayit_Click" Style="{StaticResource PrimaryButton}" Height="40"/>
                    </StackPanel>


                </Grid>

                <!-- 4. Status Section -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                    <Ellipse x:Name="ConnStatus" Width="12" Height="12" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#EF4444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSlowConnection}" Value="True"><Setter Property="Fill" Value="#F59E0B"/></DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsSlowConnection}" Value="False"/><Condition Binding="{Binding IsConnected}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="#10B981"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ConnectionStatus}" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>