<Window x:Class="PersonelTakip.Views.CihazGecmisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cihaz Hareket Geçmişi" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Cihaz Hareket Geçmişi" FontSize="20" FontWeight="Bold" Foreground="#1E2937"/>
            <TextBlock Text="{Binding CihazBilgi}" FontSize="12" Foreground="#64748B" Margin="0,5,0,0"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Hareketler}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" BorderThickness="1" BorderBrush="#E5E7EB">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih, StringFormat=dd.MM.yyyy HH:mm}" Width="130"/>
                <DataGridTextColumn Header="İşlem" Binding="{Binding IslemTuru}" Width="100"/>
                <DataGridTextColumn Header="Nereden" Binding="{Binding NeredenSantiyeAdi}" Width="120"/>
                <DataGridTextColumn Header="Nereye" Binding="{Binding NereyeSantiyeAdi}" Width="120"/>
                <DataGridTextColumn Header="Kullanıcı" Binding="{Binding KullaniciAdi}" Width="100"/>
                <DataGridTextColumn Header="Açıklama" Binding="{Binding Aciklama}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="Kapat" Command="{Binding KapatCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" 
                Width="100" Height="40" Background="#3B82F6" Foreground="White" BorderThickness="0" HorizontalAlignment="Right" Margin="0,15,0,0"/>
    </Grid>
</Window>
