<Window x:Class="PersonelTakip.Views.OfisCihazGecmisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:PersonelTakip.Controls"
        xmlns:converters="clr-namespace:PersonelTakip.Converters"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="850" Width="1350"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource ModernWindowStyle}"
        Background="#0F172A"
        FontFamily="Segoe UI">

    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Custom Title Bar -->
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <controls:CustomTitleBar Grid.Row="0"/>

        <!-- Header Panel -->
        <Border Grid.Row="1" Background="#1E293B" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="25,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Ofis Cihazı Zimmet Geçmişi" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Cihaz hareketleri ve personel zimmet detayları" FontSize="13" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="10" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" Height="40" Width="300" Margin="0,0,15,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.5" Foreground="White"/>
                            <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" 
                                     Foreground="White" CaretBrush="White" Padding="5,0,15,0"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </Border>
                    
                    <Button Content="Excel'e Aktar" Command="{Binding ExcelAktarCommand}" 
                            Width="130" Height="40" Background="#10B981" Foreground="White" FontWeight="SemiBold" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="2" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>      <!-- List -->
                <ColumnDefinition Width="420"/>    <!-- Detail Card -->
            </Grid.ColumnDefinitions>

            <!-- Sol: Hareket Listesi -->
            <Border Grid.Column="0" Margin="0,0,20,0" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="1">
                <DataGrid ItemsSource="{Binding HareketlerView}" SelectedItem="{Binding SelectedHareket}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" 
                          GridLinesVisibility="None" BorderThickness="0" Background="Transparent" 
                          RowHeight="50" SelectionMode="Single">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#111827"/>
                            <Setter Property="Foreground" Value="#94A3B8"/>
                            <Setter Property="Padding" Value="15,12"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="#CBD5E1"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="#334155"/>
                            <Setter Property="Height" Value="50"/> <!-- Görsel 3'teki gibi biraz daha geniş satırlar -->
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#1E293B"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF151515"/> <!-- Görsel 3 Tam Rengi -->
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <!-- Hücre metin hizalaması ve Görsel 3 boşlukları -->
                        <Style TargetType="DataGridCell">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                            <ContentPresenter VerticalAlignment="Center" Margin="20,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#FF151515"/>
                                    <Setter Property="Foreground" Value="#3B82F6"/> <!-- Seçili metin mavi kalsın -->
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Tarih" Binding="{Binding Tarih, StringFormat='dd.MM.yyyy HH:mm'}" Width="150"/>
                        <DataGridTemplateColumn Header="İşlem" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IslemTuru}" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IslemTuru}" Value="Zimmet">
                                                        <Setter Property="Foreground" Value="#3B82F6"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IslemTuru}" Value="İade">
                                                        <Setter Property="Foreground" Value="#10B981"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Personel" Binding="{Binding PersonelAd}" Width="160"/>
                        <DataGridTextColumn Header="Cihaz" Binding="{Binding CihazAdi}" Width="*"/>
                        <DataGridTextColumn Header="Seri No" Binding="{Binding CihazSeriNo}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Sağ: Detay Kartı (Premium Design) -->
            <Border Grid.Column="1" Background="#1E293B" CornerRadius="12" BorderBrush="#334155" BorderThickness="1" Padding="25">
                <Grid>
                    <!-- Boş Durum -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                                Visibility="{Binding SelectedHareket, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Opacity="0.3"/>
                        <TextBlock Text="Detay görmek için satır seçiniz" Foreground="#64748B" Margin="0,15,0,0"/>
                    </StackPanel>

                    <!-- Detay İçeriği -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  Visibility="{Binding SelectedHareket, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                        <StackPanel DataContext="{Binding SelectedHareket}">
                            <!-- Cihaz Başlık -->
                            <Border Background="#3B82F6" CornerRadius="8" Padding="15,10" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="CİHAZ BİLGİLERİ" FontSize="11" FontWeight="Bold" Foreground="White" Opacity="0.8"/>
                                    <TextBlock Text="{Binding CihazAdi}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Cihaz Detay Grubu -->
                            <UniformGrid Columns="2" Margin="0,0,0,20">
                                <StackPanel Margin="0,0,10,15">
                                    <TextBlock Text="Markası" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                                    <Border Background="#0F172A" Padding="12,8" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                                        <TextBlock Text="{Binding CihazMarka}" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,15">
                                    <TextBlock Text="Modeli" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                                    <Border Background="#0F172A" Padding="12,8" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                                        <TextBlock Text="{Binding CihazModel}" Foreground="White" FontWeight="SemiBold"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="Seri Numarası" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                                    <Border Background="#0F172A" Padding="12,8" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                                        <TextBlock Text="{Binding CihazSeriNo}" Foreground="#F59E0B" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Özellikler" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                                <Border Background="#0F172A" Padding="12,8" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" MinHeight="40">
                                    <TextBlock Text="{Binding CihazOzellik}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Cihaz Notu / Açıklama (Kayıt)" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                                <Border Background="#0F172A" Padding="12,8" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" MinHeight="60">
                                    <TextBlock Text="{Binding CihazNot}" Foreground="#94A3B8" TextWrapping="Wrap" FontStyle="Italic"/>
                                </Border>
                            </StackPanel>

                            <!-- Zimmet Bilgileri Başlık -->
                            <Border Background="#10B981" CornerRadius="8" Padding="15,10" Margin="0,10,0,20">
                                <StackPanel>
                                    <TextBlock Text="ZİMMET / HAREKET BİLGİSİ" FontSize="11" FontWeight="Bold" Foreground="White" Opacity="0.8"/>
                                    <TextBlock Text="{Binding PersonelAd, TargetNullValue='SİSTEM / BOŞTA'}" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="2" Margin="0,0,0,20">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="İşlem Türü" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                                    <Border Background="#0F172A" Padding="12,8" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                                        <TextBlock Text="{Binding IslemTuru}" Foreground="White" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Margin="10,0,0,0">
                                    <TextBlock FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="İşlem Tarihi"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IslemTuru}" Value="Zimmet">
                                                        <Setter Property="Text" Value="Zimmet Tarihi"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IslemTuru}" Value="İade">
                                                        <Setter Property="Text" Value="İade Tarihi"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Background="#0F172A" Padding="12,8" CornerRadius="6" BorderBrush="#334155" BorderThickness="1">
                                        <TextBlock Text="{Binding Tarih, StringFormat='dd.MM.yyyy HH:mm'}" Foreground="#94A3B8" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </UniformGrid>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Zimmet/İade Notu" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                                <Border Background="#0F172A" Padding="12,8" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" MinHeight="60">
                                    <TextBlock Text="{Binding Aciklama}" Foreground="White" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="İşlemi Gerçekleştiren" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding KullaniciAdi}" Foreground="#60A5FA" FontWeight="SemiBold" Margin="5,0,0,0"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.Row="2" Background="#CC0F172A" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" CornerRadius="16">
            <StackPanel VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="250" Height="6" Background="#1E293B" Foreground="#3B82F6" BorderThickness="0"/>
                <TextBlock Text="Veriler Yükleniyor..." HorizontalAlignment="Center" Margin="0,15,0,0" Foreground="#94A3B8" FontSize="14" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
